{{ 'scroll-video.css' | asset_url | stylesheet_tag }}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if section.settings.video_url != blank or section.settings.video_url_mobile != blank -%}
<div class="scroll-video section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}" data-section-id="{{ section.id }}" data-section-type="scroll-video">
  <div class="scroll-video__container">
    {%- assign desktop_video = section.settings.video_url -%}
    {%- assign mobile_video = section.settings.video_url_mobile | default: desktop_video -%}
    
    <video 
      class="scroll-video__media desktop-video" 
      playsinline 
      muted 
      loop 
      preload="metadata"
      data-scroll-video
    >
      <source src="{{ desktop_video }}" type="video/mp4">
    </video>

    {%- if section.settings.video_url_mobile != blank -%}
      <video 
        class="scroll-video__media mobile-video" 
        playsinline 
        muted 
        loop 
        preload="metadata"
        data-scroll-video
      >
        <source src="{{ mobile_video }}" type="video/mp4">
      </video>
    {%- endif -%}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const videos = document.querySelectorAll('#shopify-section-{{ section.id }} [data-scroll-video]');
    if (videos.length === 0) return;

    // Play video when it enters the viewport, pause when it leaves
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        const video = entry.target;
        // Only handle play/pause if the video is actually visible (not hidden by CSS)
        const isVisible = window.getComputedStyle(video).display !== 'none';
        
        if (entry.isIntersecting && isVisible) {
          video.play().catch(e => console.log('Video autoplay prevented', e));
        } else {
          video.pause();
        }
      });
    }, { threshold: 0.2 });

    videos.forEach(video => observer.observe(video));
  });
</script>
{%- endif -%}

{% schema %}
{
  "name": "Scroll Video",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "video_url",
      "label": "Desktop Video Link (Shopify CDN)",
      "info": "Paste the .mp4 link from your Shopify Files"
    },
    {
      "type": "text",
      "id": "video_url_mobile",
      "label": "Mobile Video Link (Shopify CDN)",
      "info": "Optional. If empty, desktop video will be used."
    },
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        {
          "value": "accent-1",
          "label": "Accent 1"
        },
        {
          "value": "accent-2",
          "label": "Accent 2"
        },
        {
          "value": "background-1",
          "label": "Background 1"
        },
        {
          "value": "background-2",
          "label": "Background 2"
        },
        {
          "value": "inverse",
          "label": "Inverse"
        }
      ],
      "default": "background-1",
      "label": "Color Scheme"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Scroll Video"
    }
  ]
}
{% endschema %}