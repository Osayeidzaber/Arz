{% style %}
  :root {
    --header-height: {{ section.settings.header_height_desktop | default: 80 }}px;
    --header-bg: {{ section.settings.header_bg_color | default: '#efebe0' }};
    --header-text: {{ section.settings.header_text_color | default: '#3D2500' }};
    --transparent-text: {{ section.settings.transparent_text_color | default: '#3D2500' }};
    --cart-badge-bg: {{ section.settings.cart_badge_bg | default: '#3D2500' }};
    --cart-badge-text: {{ section.settings.cart_badge_text | default: '#efebe0' }};
    --header-padding: {{ section.settings.header_padding_desktop | default: 40 }}px;
    --menu-gap: {{ section.settings.menu_item_spacing | default: 20 }}px;
    --icon-gap: {{ section.settings.icon_spacing | default: 15 }}px;
    --menu-font-size: {{ section.settings.menu_font_size | default: 14 }}px;
    --logo-width: {{ section.settings.logo_width | default: 180 }}px;
    --logo-height: {{ section.settings.logo_height | default: 50 }}px;
    --search-width: {{ section.settings.search_width | default: 280 }}px;
    {%- if template.name == 'product' -%}
      --header-top-gap: {{ section.settings.header_announcement_gap_product | default: 12 }}px;
    {%- else -%}
      --header-top-gap: {{ section.settings.header_announcement_gap_general | default: 12 }}px;
    {%- endif -%}
  }
  @media (max-width: 768px) {
    :root {
      --header-height: {{ section.settings.header_height_mobile | default: 60 }}px;
      --header-padding: {{ section.settings.header_padding_mobile | default: 20 }}px;
    }
  }
{% endstyle %}

{%- comment -%} Transparent mode only where a full-bleed hero sits under the header (homepage). Elsewhere the light logo would vanish on the light page background. {%- endcomment -%}
<div class="header-wrapper {% if section.settings.enable_transparent_header and template.name == 'index' %}header-wrapper--transparent{% endif %}">
  <header class="header">
    <button class="header__mobile-trigger" id="MobileMenuTrigger" aria-label="Open mobile menu" aria-expanded="false" aria-controls="MobileDrawer">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 12h18M3 6h18M3 18h18"></path>
      </svg>
    </button>

    <nav class="header__nav header__nav--left">
      <ul class="header__menu">
        <li class="header__menu-item-wrapper">
          <a href="{{ routes.root_url }}" class="header__menu-item">Home</a>
        </li>

        {%- for link in section.settings.menu.links -%}
          {%- assign link_title = link.title | downcase | strip -%}
          {%- if link_title contains 'contact' or link_title == 'home' -%}{%- continue -%}{%- endif -%}
          
          {%- comment -%} Check if this menu item should have a mega menu from settings {%- endcomment -%}
          {%- assign has_shop_mega = false -%}
          {%- assign mega_trigger_names = section.settings.mega_menu_trigger | default: 'shop,catalog' | downcase | split: ',' -%}
          {%- for trigger_name in mega_trigger_names -%}
            {%- assign trigger_clean = trigger_name | strip | downcase -%}
            {%- if link_title == trigger_clean -%}
              {%- if section.settings.shop_mega_menu_left != blank or section.settings.mega_section_1 != blank or section.settings.mega_section_2 != blank or section.settings.mega_section_3 != blank -%}
                {%- assign has_shop_mega = true -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          
          <li class="header__menu-item-wrapper {% if has_shop_mega %}has-mega-menu{% endif %}">
            <a href="{% if link_title == 'shop' or link_title == 'catalog' %}{{ section.settings.shop_menu_url | default: '/collections/all' }}{% else %}{{ link.url }}{% endif %}" class="header__menu-item">
              {% if link_title == 'shop' or link_title == 'catalog' %}Shop{% else %}{{ link.title }}{% endif %}
              {%- if has_shop_mega -%}
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
              {%- endif -%}
            </a>

            {%- if has_shop_mega -%}
              <div class="mega-menu">
                <div class="mega-menu__inner">
                  {%- comment -%} LEFT SECTION: Shop All, New Arrivals, Collections {%- endcomment -%}
                  {%- if section.settings.shop_mega_menu_left != blank -%}
                    <div class="mega-menu__section mega-menu__section--left">
                      {%- for childlink in linklists[section.settings.shop_mega_menu_left].links -%}
                        <a href="{{ childlink.url }}" class="mega-menu__link">{{ childlink.title }}</a>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}

                  {%- comment -%} SECTION 1 {%- endcomment -%}
                  {%- if section.settings.mega_section_1 != blank -%}
                    <div class="mega-menu__divider"></div>
                    <div class="mega-menu__section">
                      {%- if section.settings.mega_section_1_title != blank -%}
                        <span class="mega-menu__section-title">{{ section.settings.mega_section_1_title }}</span>
                      {%- endif -%}
                      {%- for childlink in linklists[section.settings.mega_section_1].links -%}
                        <a href="{{ childlink.url }}" class="mega-menu__link">{{ childlink.title }}</a>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}

                  {%- comment -%} SECTION 2 {%- endcomment -%}
                  {%- if section.settings.mega_section_2 != blank -%}
                    <div class="mega-menu__divider"></div>
                    <div class="mega-menu__section">
                      {%- if section.settings.mega_section_2_title != blank -%}
                        <span class="mega-menu__section-title">{{ section.settings.mega_section_2_title }}</span>
                      {%- endif -%}
                      {%- for childlink in linklists[section.settings.mega_section_2].links -%}
                        <a href="{{ childlink.url }}" class="mega-menu__link">{{ childlink.title }}</a>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}

                  {%- comment -%} SECTION 3 {%- endcomment -%}
                  {%- if section.settings.mega_section_3 != blank -%}
                    <div class="mega-menu__divider"></div>
                    <div class="mega-menu__section">
                      {%- if section.settings.mega_section_3_title != blank -%}
                        <span class="mega-menu__section-title">{{ section.settings.mega_section_3_title }}</span>
                      {%- endif -%}
                      {%- for childlink in linklists[section.settings.mega_section_3].links -%}
                        <a href="{{ childlink.url }}" class="mega-menu__link">{{ childlink.title }}</a>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      {%- if section.settings.featured_collection_name != blank and settings.enable_eid_hero_button == false -%}
        <div class="header__special-btn-wrapper">
          <a href="{{ section.settings.featured_collection_link | default: '#' }}" class="header__special-btn">
            {{ section.settings.featured_collection_name }}
          </a>
        </div>
      {%- endif -%}
    </nav>

    <div class="header__logo">
      <a href="{{ routes.root_url }}">
        <svg class="header__logo-img header__logo-main" width="180" height="108" viewBox="0 0 375 225" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg">
