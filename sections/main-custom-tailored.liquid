  .measure-input-wrap input {
    padding: 12px 32px 12px 12px;
    font-size: 16px; /* Prevents iOS zoom */
    border-radius: 8px;
  }

  .toggle-content {
    flex-direction: row;
    padding: 14px;
    gap: 12px;
    justify-content: flex-start;
  }

  .toggle-content svg {
    width: 20px;
    height: 20px;
    margin: 0;
  }

  .toggle-content span {
    font-size: 13px;
  }

  .catalog-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }

  .catalog-image {
    border-radius: 10px;
  }

  .catalog-name {
    font-size: 12px;
  }

  .catalog-price {
    font-size: 11px;
  }

  .upload-area {
    border-radius: 12px;
  }

  .upload-content {
    padding: 32px 16px;
  }

  .upload-icon {
    width: 52px;
    height: 52px;
  }

  .upload-icon svg {
    width: 24px;
    height: 24px;
  }

  .upload-text strong {
    font-size: 14px;
  }

  .upload-text span {
    font-size: 12px;
  }

  .notes-section textarea {
    padding: 12px;
    font-size: 16px; /* Prevents iOS zoom */
    min-height: 80px;
    border-radius: 10px;
  }

  .step-nav {
    margin-top: 24px;
    padding-top: 20px;
    flex-direction: column-reverse;
    gap: 10px;
  }

  .btn-back,
  .btn-next,
  .btn-submit {
    width: 100%;
    justify-content: center;
    padding: 14px 20px;
    border-radius: 10px;
  }

  .btn-back {
    background: #f5f5f5;
    border: none;
  }

  .form-success {
    padding: 32px 16px;
  }

  .success-animation {
    width: 64px;
    height: 64px;
    margin-bottom: 20px;
  }

  .success-checkmark {
    width: 48px;
    height: 48px;
  }

  .form-success h3 {
    font-size: 20px;
  }

  .form-success p {
    font-size: 14px;
  }

  .btn-reset {
    width: 100%;
    padding: 14px;
  }

  .form-contact-footer {
    margin-top: 24px;
    padding-top: 20px;
  }

  .form-contact-links {
    flex-direction: column;
    gap: 8px;
  }

  .form-contact-btn {
    width: 100%;
    justify-content: center;
    padding: 12px;
  }
}

/* Small phones (iPhone SE, etc) */
@media (max-width: 375px) {
  .page-layout {
    padding: 10px;
  }

  .info-panel__title {
    font-size: 20px;
    letter-spacing: 1px;
  }

  .form-card {
    padding: 16px 12px;
  }

  .step-title {
    font-size: 16px;
  }

  .size-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .catalog-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
  }
}

/* iOS safe areas */
@supports (padding: max(0px)) {
  .custom-tailored-page {
    padding-left: max(12px, env(safe-area-inset-left));
    padding-right: max(12px, env(safe-area-inset-right));
    padding-bottom: max(20px, env(safe-area-inset-bottom));
  }
}

/* Touch improvements */
@media (hover: none) and (pointer: coarse) {
  .size-option,
  .catalog-card,
  .design-toggle,
  .size-toggle,
  .btn-next,
  .btn-back,
  .btn-submit,
  .contact-link,
  .form-contact-btn {
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  .size-box,
  .toggle-content,
  .catalog-image {
    transition: transform 0.1s ease, border-color 0.2s ease;
  }

  .size-option:active .size-box,
  .catalog-card:active .catalog-image {
    transform: scale(0.97);
  }
}

/* Prevent horizontal scroll */
.custom-tailored-page,
.page-layout,
.form-card {
  max-width: 100%;
  overflow-x: hidden;
}

/* Fix for iOS input zoom */
@media screen and (-webkit-min-device-pixel-ratio: 0) {
  input[type="text"],
  input[type="email"],
  input[type="tel"],
  textarea,
  select {
    font-size: 16px;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const form = document.getElementById('CustomTailoredForm');
  const submitBtn = document.getElementById('SubmitBtn');
  const btnText = document.getElementById('BtnText');
  const btnLoading = document.getElementById('BtnLoading');
  const imgbbApiKey = '{{ section.settings.imgbb_api_key }}';

  // Uploaded image URL storage
  let uploadedImageUrl = '';

  // ================================
  // CATALOG GALLERY NAVIGATION
  // ================================

  document.querySelectorAll('.catalog-card.has-gallery').forEach(card => {
    const wrapper = card.querySelector('[data-gallery-wrapper]');
    const images = wrapper.querySelectorAll('.catalog-gallery-image');
    const dots = wrapper.querySelectorAll('.catalog-gallery-dot');
    const prevBtn = wrapper.querySelector('.catalog-gallery-arrow.prev');
    const nextBtn = wrapper.querySelector('.catalog-gallery-arrow.next');

    if (images.length <= 1) return;

    let currentIndex = 0;

    function showImage(index) {
      if (index < 0) index = images.length - 1;
      if (index >= images.length) index = 0;
      currentIndex = index;

      images.forEach((img, i) => {
        img.classList.toggle('is-active', i === currentIndex);
      });

      dots.forEach((dot, i) => {
        dot.classList.toggle('is-active', i === currentIndex);
      });
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        showImage(currentIndex - 1);
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        showImage(currentIndex + 1);
      });
    }

    dots.forEach((dot, i) => {
      dot.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        showImage(i);
      });
    });

    // Touch/swipe support
    let touchStartX = 0;
    wrapper.addEventListener('touchstart', (e) => {
      touchStartX = e.touches[0].clientX;
    }, { passive: true });

    wrapper.addEventListener('touchend', (e) => {
      const diff = touchStartX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 50) {
        showImage(diff > 0 ? currentIndex + 1 : currentIndex - 1);
      }
    }, { passive: true });
  });

  // ================================
  // DESIGN SHOWCASE GALLERY
  // ================================

  document.querySelectorAll('.design-showcase__item').forEach(item => {
    const gallery = item.querySelector('[data-showcase-gallery]');
    const images = gallery.querySelectorAll('.design-showcase__image');
    const prevBtn = gallery.querySelector('.design-showcase__arrow--prev');
    const nextBtn = gallery.querySelector('.design-showcase__arrow--next');
    const counterCurrent = gallery.querySelector('.design-showcase__current');

    if (images.length <= 1) return;

    let currentIndex = 0;

    function showImage(index) {
      if (index < 0) index = images.length - 1;
      if (index >= images.length) index = 0;
      currentIndex = index;

      images.forEach((img, i) => {
        img.classList.toggle('is-active', i === currentIndex);
      });

      if (counterCurrent) {
        counterCurrent.textContent = currentIndex + 1;
      }
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', () => showImage(currentIndex - 1));
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => showImage(currentIndex + 1));
    }

    // Touch/swipe support for showcase
    let touchStartX = 0;
    gallery.addEventListener('touchstart', (e) => {
      touchStartX = e.touches[0].clientX;
    }, { passive: true });

    gallery.addEventListener('touchend', (e) => {
      const diff = touchStartX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 50) {
        showImage(diff > 0 ? currentIndex + 1 : currentIndex - 1);
      }
    }, { passive: true });
  });

  // ================================
  // MULTI-STEP FORM NAVIGATION
  // ================================

  const steps = document.querySelectorAll('.form-step');
  const progressSteps = document.querySelectorAll('.progress-step');
  let currentStep = 1;

  function goToStep(stepNum) {
    // Validate current step before proceeding
    if (stepNum > currentStep && !validateStep(currentStep)) {
      return;
    }

    steps.forEach(step => {
      step.classList.remove('active');
      if (parseInt(step.dataset.step) === stepNum) {
        step.classList.add('active');
      }
    });

    progressSteps.forEach(ps => {
      const psStep = parseInt(ps.dataset.step);
      ps.classList.remove('active', 'completed');
      if (psStep === stepNum) {
        ps.classList.add('active');
      } else if (psStep < stepNum) {
        ps.classList.add('completed');
      }
    });

    currentStep = stepNum;

    // Scroll to top of form
    document.querySelector('.form-card').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function validateStep(step) {
    if (step === 1) {
      const name = form.querySelector('input[name="name"]');
      const email = form.querySelector('input[name="email"]');
      const phone = form.querySelector('input[name="phone"]');

      if (!name.value.trim()) {
        showFieldError(name, 'Please enter your name');
        return false;
      }
      if (!email.value.trim() || !email.validity.valid) {
        showFieldError(email, 'Please enter a valid email');
        return false;
      }
      if (!phone.value.trim()) {
        showFieldError(phone, 'Please enter your phone number');
        return false;
      }
    }
    return true;
  }

  function showFieldError(field, message) {
    field.focus();
    field.style.borderColor = '#dc2626';
    field.style.animation = 'shake 0.4s ease';

    setTimeout(() => {
      field.style.borderColor = '';
      field.style.animation = '';
    }, 2000);
  }

  // Add shake animation
  const style = document.createElement('style');
  style.textContent = `
    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-8px); }
      75% { transform: translateX(8px); }
    }
  `;
  document.head.appendChild(style);

  // Navigation buttons
  document.querySelectorAll('.btn-next').forEach(btn => {
    btn.addEventListener('click', () => {
      const nextStep = parseInt(btn.dataset.next);
      goToStep(nextStep);
    });
  });

  document.querySelectorAll('.btn-back').forEach(btn => {
    btn.addEventListener('click', () => {
      const prevStep = parseInt(btn.dataset.back);
      goToStep(prevStep);
    });
  });

  // ================================
  // SIZE TYPE TOGGLE
  // ================================

  document.querySelectorAll('.size-toggle').forEach(toggle => {
    toggle.addEventListener('click', () => {
      document.querySelectorAll('.size-toggle').forEach(t => t.classList.remove('active'));
      toggle.classList.add('active');

      const isCustom = toggle.dataset.type === 'custom';
      document.getElementById('StandardSizes').style.display = isCustom ? 'none' : 'block';
      document.getElementById('CustomSizes').style.display = isCustom ? 'block' : 'none';
      document.getElementById('SizeTypeInput').value = toggle.dataset.type;
    });
  });

  // ================================
  // DESIGN PATH TOGGLE
  // ================================

  const catalogSection = document.getElementById('CatalogSection');
  const uploadSection = document.getElementById('UploadSection');

  document.querySelectorAll('input[name="design_path"]').forEach(radio => {
    radio.addEventListener('change', () => {
      const isCatalog = document.getElementById('PathCatalog').checked;
      catalogSection.style.display = isCatalog ? 'block' : 'none';
      uploadSection.style.display = isCatalog ? 'none' : 'block';
    });
  });

  // ================================
  // CATALOG SELECTION
  // ================================

  const catalogInput = document.getElementById('CatalogInput');
  document.querySelectorAll('.catalog-card').forEach(item => {
    item.addEventListener('click', () => {
      document.querySelectorAll('.catalog-card').forEach(i => i.classList.remove('selected'));
      item.classList.add('selected');
      catalogInput.value = item.dataset.value;
    });
  });

  // ================================
  // FILE UPLOAD WITH IMGBB
  // ================================

  const fileInput = document.getElementById('FileInput');
  const uploadBox = document.getElementById('UploadBox');
  const uploadPlaceholder = document.getElementById('UploadPlaceholder');
  const uploadFile = document.getElementById('UploadFile');
  const uploadProgress = document.getElementById('UploadProgress');
  const progressFill = document.getElementById('ProgressFill');
  const fileName = document.getElementById('FileName');
  const previewImage = document.getElementById('PreviewImage');
  const designImageUrl = document.getElementById('DesignImageUrl');

  // Drag and drop
  ['dragenter', 'dragover'].forEach(e => {
    uploadBox.addEventListener(e, (ev) => {
      ev.preventDefault();
      uploadBox.classList.add('drag-over');
    });
  });

  ['dragleave', 'drop'].forEach(e => {
    uploadBox.addEventListener(e, (ev) => {
      ev.preventDefault();
      uploadBox.classList.remove('drag-over');
    });
  });

  // File selection
  fileInput.addEventListener('change', async () => {
    const file = fileInput.files[0];
    if (!file) return;

    // Validate file size (10MB max)
    if (file.size > 10 * 1024 * 1024) {
      alert('File size must be less than 10MB');
      fileInput.value = '';
      return;
    }

    // Show progress
    uploadPlaceholder.style.display = 'none';
    uploadFile.style.display = 'none';
    uploadProgress.style.display = 'block';

    // Upload to Imgbb if API key exists, otherwise just show preview
    if (imgbbApiKey && file.type.startsWith('image/')) {
      try {
        const formData = new FormData();
        formData.append('image', file);
        formData.append('key', imgbbApiKey);

        // Simulate progress
        let progress = 0;
        const progressInterval = setInterval(() => {
          progress += Math.random() * 20;
          if (progress > 90) progress = 90;
          progressFill.style.width = progress + '%';
        }, 200);

        const response = await fetch('https://api.imgbb.com/1/upload', {
          method: 'POST',
          body: formData
        });

        clearInterval(progressInterval);
        progressFill.style.width = '100%';

        const result = await response.json();

        if (result.success) {
          uploadedImageUrl = result.data.url;
          designImageUrl.value = uploadedImageUrl;

          // Show preview
          setTimeout(() => {
            uploadProgress.style.display = 'none';
            uploadFile.style.display = 'flex';
            fileName.textContent = file.name;
            previewImage.style.backgroundImage = `url(${result.data.thumb?.url || result.data.url})`;
          }, 300);
        } else {
          throw new Error('Upload failed');
        }
      } catch (err) {
        console.error('Upload error:', err);
        // Fallback - show file locally
        showLocalPreview(file);
      }
    } else {
      // No API key or non-image file - show local preview
      showLocalPreview(file);
    }
  });

  function showLocalPreview(file) {
    uploadProgress.style.display = 'none';
    uploadFile.style.display = 'flex';
    fileName.textContent = file.name;

    if (file.type.startsWith('image/')) {
      const reader = new FileReader();
      reader.onload = (e) => {
        previewImage.style.backgroundImage = `url(${e.target.result})`;
      };
      reader.readAsDataURL(file);
    } else {
      previewImage.style.backgroundImage = 'none';
      previewImage.style.background = '#f0f0f0';
    }
  }

  // Remove file
  document.getElementById('RemoveFile').addEventListener('click', (e) => {
    e.preventDefault();
    e.stopPropagation();
    fileInput.value = '';
    uploadedImageUrl = '';
    designImageUrl.value = '';
    previewImage.style.backgroundImage = '';
    uploadFile.style.display = 'none';
    uploadPlaceholder.style.display = 'flex';
  });

  // ================================
  // FORM SUBMISSION
  // ================================

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const isCatalog = document.getElementById('PathCatalog').checked;

    // Validation
    if (isCatalog && !catalogInput.value) {
      alert('Please select a design from the catalog.');
      return;
    }
    if (!isCatalog && !fileInput.files.length && !uploadedImageUrl) {
      alert('Please upload your design.');
      return;
    }

    submitBtn.disabled = true;
    btnText.style.display = 'none';
    btnLoading.style.display = 'inline-flex';

    try {
      // Prepare form data
      const formData = new FormData();
      formData.append('access_key', form.querySelector('input[name="access_key"]').value);
      formData.append('subject', 'New Custom Order - ARZ');
      formData.append('from_name', 'ARZ Custom Orders');
      formData.append('name', form.querySelector('input[name="name"]').value);
      formData.append('email', form.querySelector('input[name="email"]').value);
      formData.append('phone', form.querySelector('input[name="phone"]').value);
      formData.append('location', form.querySelector('input[name="location"]').value || '-');
      formData.append('message', form.querySelector('textarea[name="message"]').value || '-');

      // Size info
      const sizeType = document.getElementById('SizeTypeInput').value;
      if (sizeType === 'standard') {
        const selectedSize = form.querySelector('input[name="size"]:checked');
        formData.append('size', `Standard: ${selectedSize ? selectedSize.value : '-'}`);
      } else {
        const chest = form.querySelector('input[name="measurement_chest"]').value || '-';
        const length = form.querySelector('input[name="measurement_length"]').value || '-';
        const shoulder = form.querySelector('input[name="measurement_shoulder"]').value || '-';
        const sleeve = form.querySelector('input[name="measurement_sleeve"]').value || '-';
        formData.append('size', `Custom: Chest ${chest}" / Length ${length}" / Shoulder ${shoulder}" / Sleeve ${sleeve}"`);
      }

      // Design info
      if (isCatalog) {
        formData.append('design', `Catalog Selection: ${catalogInput.value}`);
      } else {
        const designUrl = uploadedImageUrl || 'File attached (see Discord)';
        formData.append('design', `Custom Upload: ${fileInput.files[0]?.name || 'Design'}`);
        if (uploadedImageUrl) {
          formData.append('design_image_url', uploadedImageUrl);
        }
      }

      // Submit to Web3Forms
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: formData
      });
      const result = await res.json();

      if (result.success) {
        // Send to Discord webhook if configured
        const webhook = '{{ section.settings.discord_webhook }}';
        if (webhook) {
          const sizeInfo = formData.get('size');

          // Build design info with image URL if available
          let designInfo = isCatalog ? `Catalog: ${catalogInput.value}` : `Custom Upload: ${fileInput.files[0]?.name || 'Design'}`;
          if (uploadedImageUrl) {
            designInfo += `\n**Image:** ${uploadedImageUrl}`;
          }

          const embedFields = [
            { name: 'Name', value: formData.get('name'), inline: true },
            { name: 'Email', value: formData.get('email'), inline: true },
            { name: 'Phone', value: formData.get('phone'), inline: true },
            { name: 'Location', value: formData.get('location') || '-', inline: true },
            { name: 'Size', value: sizeInfo, inline: false },
            { name: 'Design', value: designInfo, inline: false },
            { name: 'Message', value: formData.get('message') || '-', inline: false }
          ];

          const embed = {
            title: 'New Custom Order Request',
            color: 12497525,
            fields: embedFields,
            timestamp: new Date().toISOString()
          };

          // Add image preview to embed if available
          if (uploadedImageUrl) {
            embed.image = { url: uploadedImageUrl };
          }

          fetch(webhook, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ embeds: [embed] })
          }).catch(() => {});
        }

        // Show success
        form.style.display = 'none';
        document.querySelector('.form-progress').style.display = 'none';
        const successEl = document.getElementById('FormSuccess');
        successEl.style.display = 'flex';

      } else {
        throw new Error(result.message || 'Submission failed');
      }
    } catch (err) {
      console.error('Submit error:', err);
      document.getElementById('FormErrorMessage').textContent = err.message || 'Something went wrong. Please try again.';
      document.getElementById('FormError').style.display = 'flex';
    } finally {
      submitBtn.disabled = false;
      btnText.style.display = 'inline-flex';
      btnLoading.style.display = 'none';
    }
  });
});
</script>

