        </div>
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.enable_carousel and slides_count > 1 -%}
    <div class="hero__dots">
      {%- for i in (1..slides_count) -%}
        <button class="hero__dot {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"></button>
