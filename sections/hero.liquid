<section class="hero{% if section.settings.enable_zoom %} hero--zoom-enabled{% endif %}" id="Hero-{{ section.id }}" style="--desktop-height: {{ section.settings.desktop_height }}vh; --mobile-height: {{ section.settings.mobile_height }}vh; --image-fit: {{ section.settings.image_fit }}; --image-position: {{ section.settings.image_position }};">
  <div class="hero__carousel">
    {%- if section.settings.enable_carousel -%}
      {%- assign slides_count = 1 -%}
      <div class="hero__slide is-active" data-index="0">
        <div class="hero__media">
          {%- if section.settings.use_video and section.settings.video != blank -%}
            <video
              class="hero__video"
              {% if section.settings.video_autoplay %}autoplay{% endif %}
              {% if section.settings.video_loop %}loop{% endif %}
              {% if section.settings.video_muted %}muted{% endif %}
              playsinline
              {% if section.settings.video_poster != blank %}poster="{{ section.settings.video_poster | image_url: width: 2000 }}"{% endif %}
            >
              {%- if section.settings.mobile_video != blank -%}
                <source media="(max-width: 768px)" src="{{ section.settings.mobile_video }}" type="video/mp4">
              {%- endif -%}
              <source src="{{ section.settings.video }}" type="video/mp4">
              {%- if section.settings.video_poster != blank -%}
                <img src="{{ section.settings.video_poster | image_url: width: 2000 }}" alt="{{ section.settings.title | escape }}" loading="lazy" width="2000" height="{{ 2000 | divided_by: section.settings.video_poster.aspect_ratio | round }}">
              {%- endif -%}
            </video>
          {%- elsif section.settings.image != blank -%}
            <picture>
              {%- if section.settings.mobile_image != blank -%}
                <source media="(max-width: 768px)" srcset="{{ section.settings.mobile_image | image_url: width: 1000 }}">
              {%- endif -%}
              <img src="{{ section.settings.image | image_url: width: 2000 }}" alt="{{ section.settings.title }}" loading="eager" class="hero__image" width="2000" height="1000">
            </picture>
          {%- else -%}
            <div class="hero__placeholder"></div>
          {%- endif -%}
          <div class="hero__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}"></div>
        </div>
        <div class="hero__content">
          <div class="hero__text">
            {%- if section.settings.show_subtitle and section.settings.subtitle != blank -%}
              <p class="hero__subtitle animate-fade-up" style="--delay: 0.3s">{{ section.settings.subtitle }}</p>
            {%- endif -%}
            {%- if section.settings.show_title and section.settings.title != blank -%}
              <h1 class="hero__title animate-fade-up" style="--delay: 0.5s">{{ section.settings.title }}</h1>
            {%- endif -%}
            <div class="hero__buttons animate-fade-up" style="--delay: 0.7s">
              {%- if settings.enable_eid_hero_button -%}
                <a href="https://arzlifestyle.com/collections/threads-of-eden" class="eid-btn">
                  <!-- Lantern Left -->
                  <svg class="eid-btn__lantern eid-btn__lantern--left" viewBox="0 0 40 70" fill="none">
                    <line x1="20" y1="0" x2="20" y2="12" stroke="#BFA27E" stroke-width="1.5"/>
                    <ellipse cx="20" cy="14" rx="8" ry="3" fill="#BFA27E"/>
                    <path d="M11 16 Q20 20 29 16 L29 50 Q20 54 11 50 Z" fill="#BFA27E" opacity="0.9"/>
                    <path d="M11 16 Q20 20 29 16 L29 50 Q20 54 11 50 Z" fill="url(#lanternGrad)" opacity="0.4"/>
                    <ellipse cx="20" cy="52" rx="8" ry="3" fill="#BFA27E"/>
                    <path d="M16 54 L20 64 L24 54" fill="#BFA27E" opacity="0.8"/>
                    <defs><linearGradient id="lanternGrad" x1="0%" y1="0%" x2="0%" y2="100%"><stop offset="0%" stop-color="#fff" stop-opacity="0.6"/><stop offset="100%" stop-color="#BFA27E" stop-opacity="0"/></linearGradient></defs>
                  </svg>

                  <!-- Crescent + Star -->
                  <svg class="eid-btn__moon" viewBox="0 0 36 36" fill="#BFA27E">
                    <path d="M18 4a11 11 0 0 0 0 28 9 9 0 0 1 0-28z"/>
                    <polygon points="28,10 29.5,14 34,14.5 30.5,17.5 31.5,22 28,19.5 24.5,22 25.5,17.5 22,14.5 26.5,14" fill="#BFA27E"/>
                  </svg>

                  <span class="eid-btn__text">{{ settings.eid_hero_button_text | default: 'Shop Eid Collection' }}</span>

                  <!-- Lantern Right -->
                  <svg class="eid-btn__lantern eid-btn__lantern--right" viewBox="0 0 40 70" fill="none">
                    <line x1="20" y1="0" x2="20" y2="12" stroke="#BFA27E" stroke-width="1.5"/>
                    <ellipse cx="20" cy="14" rx="8" ry="3" fill="#BFA27E"/>
                    <path d="M11 16 Q20 20 29 16 L29 50 Q20 54 11 50 Z" fill="#BFA27E" opacity="0.9"/>
                    <path d="M11 16 Q20 20 29 16 L29 50 Q20 54 11 50 Z" fill="url(#lanternGrad2)" opacity="0.4"/>
                    <ellipse cx="20" cy="52" rx="8" ry="3" fill="#BFA27E"/>
