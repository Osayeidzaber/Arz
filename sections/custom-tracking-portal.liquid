{{ 'order-tracking.css' | asset_url | stylesheet_tag }}

<div class="tracking-portal" style="background-color: {{ section.settings.bg_color }};">
  <div class="tracking-portal__container" 
    data-api-key="{{ section.settings.api_key }}" 
    data-secret-key="{{ section.settings.secret_key }}"
  >
    <div class="tracking-portal__brand">
      {%- if section.settings.image != blank -%}
        <img 
          src="{{ section.settings.image | image_url: width: 1000 }}" 
          alt="{{ section.settings.image.alt | escape }}"
          class="tracking-portal__brand-image"
          loading="lazy"
        >
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'tracking-portal__brand-image' }}
      {%- endif -%}
      
      <div class="tracking-portal__brand-content">
        <h2 class="tracking-portal__brand-title">{{ section.settings.brand_title }}</h2>
        <p class="tracking-portal__brand-text">{{ section.settings.brand_text }}</p>
      </div>
    </div>

    <div class="tracking-portal__form-side">
      <div class="tracking-portal__form-header">
        <h1 class="tracking-portal__title">{{ section.settings.form_title }}</h1>
        <p class="tracking-portal__subtitle">{{ section.settings.form_subtitle }}</p>
      </div>

      <form id="OrderTrackingForm" class="tracking-form" action="#">
        <div class="tracking-form__field">
          <label class="tracking-form__label" for="tracking_order_id">{{ section.settings.order_id_label }}</label>
          <input 
            type="text" 
            id="tracking_order_id" 
            name="order_id" 
            class="tracking-form__input" 
            placeholder="{{ section.settings.order_id_placeholder }}"
            required
          >
          <span class="tracking-form__error">{{ section.settings.error_order_id }}</span>
        </div>

        <div class="tracking-form__field">
          <label class="tracking-form__label" for="tracking_contact">{{ section.settings.contact_label }}</label>
          <input 
            type="text" 
            id="tracking_contact" 
            name="contact" 
            class="tracking-form__input" 
            placeholder="{{ section.settings.contact_placeholder }}"
            required
          >
          <span class="tracking-form__error">{{ section.settings.error_contact }}</span>
        </div>

        <button type="submit" class="tracking-form__button">
          <span>{{ section.settings.button_text }}</span>
        </button>
      </form>

      <div id="TrackingResults" class="tracking-results" style="display: none;">
        <div class="tracking-results__header">
          <h3 class="tracking-results__status-title">Status: <span id="StatusLabel">---</span></h3>
        </div>
        <div class="tracking-results__details">
          <div class="tracking-results__row">
            <span class="tracking-results__label">Consignment ID:</span>
            <span id="ResultCID" class="tracking-results__value">---</span>
          </div>
          <div class="tracking-results__row">
            <span class="tracking-results__label">Recipient:</span>
            <span id="ResultRecipient" class="tracking-results__value">---</span>
          </div>
          <div class="tracking-results__row">
            <span class="tracking-results__label">Address:</span>
            <span id="ResultAddress" class="tracking-results__value">---</span>
          </div>
        </div>
        <button id="ResetTracking" class="tracking-results__reset btn--secondary">Track Another Order</button>
      </div>
    </div>
  </div>
</div>

<script src="{{ 'order-tracking.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Order Tracking Portal",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#efebe0"
    },
    {
      "type": "header",
      "content": "Brand Side"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Brand Image"
    },
    {
      "type": "text",
      "id": "brand_title",
      "label": "Brand Title",
      "default": "Track Your Order"
    },
    {
      "type": "textarea",
      "id": "brand_text",
      "label": "Brand Text",
      "default": "Enter your details to see the current status of your shipment."
    },
    {
      "type": "header",
      "content": "Form Side"
    },
    {
      "type": "text",
      "id": "form_title",
      "label": "Form Title",
      "default": "Order Status"
    },
    {
      "type": "text",
      "id": "form_subtitle",
      "label": "Form Subtitle",
      "default": "Check the progress of your delivery."
    },
    {
      "type": "text",
      "id": "order_id_label",
      "label": "Order ID Label",
      "default": "Order Number / Tracking ID"
    },
    {
      "type": "text",
      "id": "order_id_placeholder",
      "label": "Order ID Placeholder",
      "default": "#12345 or Consignment ID"
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "Contact Label",
      "default": "Email or Phone Number"
    },
    {
      "type": "text",
      "id": "contact_placeholder",
      "label": "Contact Placeholder",
      "default": "email@example.com"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Check Order"
    },
    {
      "type": "header",
      "content": "Errors"
    },
    {
      "type": "text",
      "id": "error_order_id",
      "label": "Order ID Error",
      "default": "Please enter a valid order number or tracking ID."
    },
    {
      "type": "text",
      "id": "error_contact",
      "label": "Contact Error",
      "default": "Please enter your email or phone number."
    },
    {
      "type": "header",
      "content": "API Configuration",
      "info": "Obtain these from your Steadfast Courier Dashboard"
    },
    {
      "type": "text",
      "id": "api_key",
      "label": "API Key"
    },
    {
      "type": "text",
      "id": "secret_key",
      "label": "Secret Key"
    }
  ],
  "presets": [
    {
      "name": "Order Tracking Portal"
    }
  ]
}
{% endschema %}
