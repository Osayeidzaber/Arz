                    <line x1="20" y1="0" x2="20" y2="12" stroke="#BFA27E" stroke-width="1.5"/>
                    <ellipse cx="20" cy="14" rx="8" ry="3" fill="#BFA27E"/>
                    <path d="M11 16 Q20 20 29 16 L29 50 Q20 54 11 50 Z" fill="#BFA27E" opacity="0.9"/>
                    <path d="M11 16 Q20 20 29 16 L29 50 Q20 54 11 50 Z" fill="url(#lanternGrad2)" opacity="0.4"/>
                    <ellipse cx="20" cy="52" rx="8" ry="3" fill="#BFA27E"/>
                    <path d="M16 54 L20 64 L24 54" fill="#BFA27E" opacity="0.8"/>
                    <defs><linearGradient id="lanternGrad2" x1="0%" y1="0%" x2="0%" y2="100%"><stop offset="0%" stop-color="#fff" stop-opacity="0.6"/><stop offset="100%" stop-color="#BFA27E" stop-opacity="0"/></linearGradient></defs>
                  </svg>

                  <!-- Arrow -->
                  <svg class="eid-btn__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </a>
              {%- else -%}
                {%- if section.settings.button_1_text != blank -%}
                  <a href="{{ section.settings.button_1_link | default: '#' }}" class="hero__button">
                    <span>{{ section.settings.button_1_text }}</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </a>
                {%- endif -%}
                {%- if section.settings.button_2_text != blank -%}
                  <a href="{{ section.settings.button_2_link | default: '#' }}" class="hero__button hero__button--secondary">
                    <span>{{ section.settings.button_2_text }}</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
