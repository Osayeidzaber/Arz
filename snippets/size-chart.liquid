{% comment %}
  Size Chart Snippet - Shows different size charts based on product type
  Usage: {% render 'size-chart', product: product %}
{% endcomment %}

{% comment %} Detect product type and show appropriate size chart {% endcomment %}
{%- assign product_type_lower = product.type | downcase -%}
{%- assign product_title_lower = product.title | downcase -%}
{%- assign product_tags_lower = product.tags | join: ',' | downcase -%}

<div class="size-chart-modal" id="sizeChartModal" style="display: none;">
  <div class="size-chart-modal__overlay" onclick="closeSizeChart()"></div>
  <div class="size-chart-modal__content">
    <button class="size-chart-modal__close" onclick="closeSizeChart()" aria-label="Close">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>
    
    {% if product_title_lower contains 'eden' or product_title_lower contains 'edan' or product_tags_lower contains 'eden' or product_tags_lower contains 'edan' %}
      {%- comment -%} EDEN COLLECTION {%- endcomment -%}
      <div class="size-chart">
        <h3 class="size-chart__title">Eden Size Chart</h3>
        <table class="size-chart__table">
          <thead>
            <tr>
              <th>Size</th>
              <th>Length</th>
              <th>Chest</th>
              <th>Shoulder</th>
              <th>Sleeve</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>S</td><td>39</td><td>41</td><td>17</td><td>22.75</td></tr>
            <tr><td>M</td><td>41</td><td>43</td><td>18</td><td>23.5</td></tr>
            <tr><td>L</td><td>43</td><td>45</td><td>18.5</td><td>23.75</td></tr>
            <tr><td>XL</td><td>45</td><td>48</td><td>19.5</td><td>26</td></tr>
          </tbody>
        </table>
        <p class="size-chart__note">All measurements in inches</p>
      </div>

    {% elsif product_type_lower contains 'traditional' or product_type_lower contains 'ceremonial' or product_type_lower contains 'panjabi' or product_type_lower contains 'kurta' %}
      {%- comment -%} TRADITIONAL & CEREMONIAL CLOTHING {%- endcomment -%}
      <div class="size-chart">
        <h3 class="size-chart__title">Traditional Wear Size Chart</h3>
        <table class="size-chart__table">
          <thead>
            <tr>
              <th>Size</th>
              <th>Chest</th>
              <th>Length</th>
              <th>Shoulder</th>
              <th>Sleeve</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>S</td><td>40"</td><td>38"</td><td>17"</td><td>24"</td></tr>
            <tr><td>M</td><td>42"</td><td>39"</td><td>17.5"</td><td>24.5"</td></tr>
            <tr><td>L</td><td>44"</td><td>40"</td><td>18"</td><td>25"</td></tr>
            <tr><td>XL</td><td>46"</td><td>41"</td><td>18.5"</td><td>25.5"</td></tr>
            <tr><td>XXL</td><td>48"</td><td>42"</td><td>19"</td><td>26"</td></tr>
            <tr><td>2XL</td><td>46"</td><td>46"</td><td>18.5"</td><td>25.5"</td></tr>
          </tbody>
        </table>
        <p class="size-chart__note">All measurements in inches</p>
      </div>
      
    {% elsif product_type_lower contains 'shirt' or product_type_lower contains 'shacket' or product_type_lower contains 'jacket' %}
      {%- comment -%} SHACKETS / SHIRTS / JACKETS {%- endcomment -%}
      <div class="size-chart">
        <h3 class="size-chart__title">Shackets Size Chart</h3>
        <table class="size-chart__table">
          <thead>
            <tr>
              <th>Size</th>
              <th>Sleeve</th>
              <th>Chest</th>
              <th>Length</th>
              <th>Shoulder</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>S</td><td>22</td><td>41</td><td>25.5</td><td>8.5</td></tr>
            <tr><td>M</td><td>22.5</td><td>43</td><td>26</td><td>9</td></tr>
            <tr><td>L</td><td>23</td><td>45</td><td>26.3</td><td>9.5</td></tr>
            <tr><td>XL</td><td>23.5</td><td>47</td><td>26.5</td><td>10</td></tr>
          </tbody>
        </table>
        <p class="size-chart__note">All measurements in inches</p>
      </div>
      
    {% elsif product_type_lower contains 'pant' or product_type_lower contains 'trouser' or product_type_lower contains 'bottom' %}
      {%- comment -%} PANTS / TROUSERS {%- endcomment -%}
      <div class="size-chart">
        <h3 class="size-chart__title">Pants Size Chart</h3>
        <table class="size-chart__table">
          <thead>
            <tr>
              <th>Size</th>
              <th>Length</th>
              <th>Waist</th>
              <th>Hip</th>
              <th>Knee Opening</th>
              <th>Leg Opening</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>M (32)</td><td>38"</td><td>32"</td><td>41"</td><td>16"</td><td>19"</td></tr>
            <tr><td>L (34)</td><td>39"</td><td>34"</td><td>42"</td><td>17"</td><td>20"</td></tr>
            <tr><td>XL (36)</td><td>40"</td><td>36"</td><td>43"</td><td>18"</td><td>21"</td></tr>
          </tbody>
        </table>
        <p class="size-chart__note">All measurements in inches</p>
      </div>
      
    {% elsif product_type_lower contains 'shoe' or product_type_lower contains 'footwear' or product_type_lower contains 'sandal' %}
      {%- comment -%} FOOTWEAR / SHOES {%- endcomment -%}
      <div class="size-chart">
        <h3 class="size-chart__title">Footwear Size Chart</h3>
        <table class="size-chart__table">
          <thead>
            <tr>
              <th>UK</th>
              <th>US</th>
              <th>EU</th>
              <th>Foot Length (cm)</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>6</td><td>7</td><td>40</td><td>25</td></tr>
            <tr><td>7</td><td>8</td><td>41</td><td>25.5</td></tr>
            <tr><td>8</td><td>9</td><td>42</td><td>26.5</td></tr>
            <tr><td>9</td><td>10</td><td>43</td><td>27</td></tr>
            <tr><td>10</td><td>11</td><td>44</td><td>28</td></tr>
            <tr><td>11</td><td>12</td><td>45</td><td>28.5</td></tr>
          </tbody>
        </table>
        <p class="size-chart__note">Measure your foot for best fit</p>
      </div>
      
    {% else %}
      {%- comment -%} DEFAULT SIZE CHART {%- endcomment -%}
      <div class="size-chart">
        <h3 class="size-chart__title">Size Guide</h3>
        <table class="size-chart__table">
          <thead>
            <tr>
              <th>Size</th>
              <th>Chest</th>
              <th>Length</th>
              <th>Shoulder</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>S</td><td>38-40"</td><td>26"</td><td>17"</td></tr>
            <tr><td>M</td><td>40-42"</td><td>27"</td><td>18"</td></tr>
            <tr><td>L</td><td>42-44"</td><td>28"</td><td>19"</td></tr>
            <tr><td>XL</td><td>44-46"</td><td>29"</td><td>20"</td></tr>
          </tbody>
        </table>
        <p class="size-chart__note">Contact us for custom sizing</p>
      </div>
    {% endif %}
    
    <div class="size-chart__image">
      <img src="{{ 'panjabi-size-chart.svg' | asset_url }}" alt="Size Guide">
    </div>
    
    <p class="size-chart__brand">Atorie™</p>
  </div>
</div>

<style>
.size-chart-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 99999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.size-chart-modal__overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.7);
}

.size-chart-modal__content {
  position: relative;
  background: linear-gradient(180deg, #2a2a2a 0%, #1a1a1a 100%);
  border-radius: 16px;
  padding: 40px;
  max-width: 520px;
  width: 90%;
  max-height: 90vh;
  overflow-y: auto;
  color: #fff;
}

.size-chart-modal__close {
  position: absolute;
  top: 16px;
  right: 16px;
  background: none;
  border: none;
  color: #888;
  cursor: pointer;
  padding: 8px;
}

.size-chart-modal__close:hover {
  color: #fff;
}

.size-chart__title {
  font-size: 24px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 2px;
  margin-bottom: 30px;
  text-align: center;
}

.size-chart__table {
  width: 100%;
  border-collapse: collapse;
  background: rgba(255,255,255,0.05);
  border-radius: 12px;
  overflow: hidden;
}

.size-chart__table th,
.size-chart__table td {
  padding: 12px 16px;
  text-align: center;
  font-size: 13px;
}

.size-chart__table th {
  font-weight: 600;
  color: #999;
  text-transform: uppercase;
  font-size: 11px;
  letter-spacing: 1px;
}

.size-chart__table tbody tr {
  border-top: 1px solid rgba(255,255,255,0.08);
}

.size-chart__table tbody tr:hover {
  background: rgba(255,255,255,0.05);
}

.size-chart__note {
  text-align: center;
  font-size: 11px;
  color: #666;
  margin-top: 20px;
}

.size-chart__brand {
  text-align: center;
  font-size: 16px;
  letter-spacing: 2px;
  color: #555;
  margin-top: 30px;
  font-weight: 600;
}

@media (max-width: 480px) {
  .size-chart-modal__content {
    padding: 30px 20px;
  }
  
  .size-chart__title {
    font-size: 18px;
  }
  
  .size-chart__table th,
  .size-chart__table td {
    padding: 10px 8px;
    font-size: 11px;
  }
}
</style>

<script>
function openSizeChart() {
  document.getElementById('sizeChartModal').style.display = 'flex';
  window.themeLockScroll('size-chart');
}

function closeSizeChart() {
  document.getElementById('sizeChartModal').style.display = 'none';
  window.themeUnlockScroll('size-chart');
}

// Close on escape key
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    closeSizeChart();
  }
});
</script>
