{% comment %}
  Product Page - Clean and Functional
  Based on prototype but streamlined for final theme
{% endcomment %}

{%- assign is_sold_out = false -%}
{%- unless product.available -%}{%- assign is_sold_out = true -%}{%- endunless -%}
{%- if product.tags contains 'sold-out' -%}{%- assign is_sold_out = true -%}{%- endif -%}

<div class="product-page {% if is_sold_out %}is-sold-out{% endif %}">
  {%- assign p_type = product.type | downcase -%}
  {%- assign p_title = product.title | downcase -%}

  {%- comment -%} Product Featured Video URL Mapping {%- endcomment -%}
  {%- assign featured_video_url = nil -%}
  {%- if p_title contains 'ali' -%}
    {%- assign featured_video_url = 'https://cdn.shopify.com/videos/c/o/v/ad71b67ba7c049f790a7dbb5b68704de.mp4' -%}
  {%- elsif p_title contains 'arzaal' -%}
    {%- assign featured_video_url = 'https://cdn.shopify.com/videos/c/o/v/d9188e6154e94e4185bf7ce32b949320.mp4' -%}
  {%- elsif p_title contains 'ayaan' -%}
    {%- assign featured_video_url = 'https://cdn.shopify.com/videos/c/o/v/3e842fa03ae148579c79885bf31baf14.mp4' -%}
  {%- elsif p_title contains 'mehran' -%}
    {%- assign featured_video_url = 'https://cdn.shopify.com/videos/c/o/v/ff9fdc910ca847309d201c5987142c3f.mp4' -%}
  {%- elsif p_title contains 'gulraaz' -%}
    {%- assign featured_video_url = 'https://cdn.shopify.com/videos/c/o/v/455350cf343647abbbda4cbf87696227.mp4' -%}
  {%- elsif p_title contains 'faris' -%}
    {%- assign featured_video_url = 'https://cdn.shopify.com/videos/c/o/v/9532243596644c2e92f49d642eeb14be.mp4' -%}
  {%- elsif p_title contains 'newaz' -%}
    {%- assign featured_video_url = 'https://cdn.shopify.com/videos/c/o/v/0d57cdf800784194be86e22d2edc6eae.mp4' -%}
  {%- elsif p_title contains 'zayir' -%}
    {%- assign featured_video_url = 'https://cdn.shopify.com/videos/c/o/v/0832dd4a686a495486754cf3ebfb508c.mp4' -%}
  {%- endif -%}
  
  {%- comment -%} Determine Category & Data early for global use {%- endcomment -%}
  {%- assign category = 'panjabi' -%}
  {%- assign p_tags_down_string = product.tags | join: ',' | downcase -%}
  {%- if p_title contains 'eden' or p_title contains 'edan' or p_tags_down_string contains 'eden' or p_tags_down_string contains 'edan' -%}
    {%- assign category = 'eden' -%}
  {%- elsif p_type contains 'shacket' or p_title contains 'shacket' or p_type contains 'shirt' or p_title contains 'shirt' -%}
     {%- assign category = 'shacket' -%}
  {%- elsif p_type contains 'pant' or p_title contains 'pant' or p_type contains 'trouser' or p_title contains 'trouser' -%}
     {%- assign category = 'pants' -%} 
  {%- else -%}
     {%- for tag in product.tags -%}
       {%- assign t = tag | downcase -%}
       {%- if t contains 'shacket' or t contains 'shirt' -%}
         {%- assign category = 'shacket' -%}{%- break -%}
       {%- elsif t contains 'pant' or t contains 'trouser' -%}
         {%- assign category = 'pants' -%}{%- break -%}
       {%- endif -%}
     {%- endfor -%}
  {%- endif -%}

  {%- if category == 'eden' -%}
    {%- assign f_labels = "Length,Chest,Shoulder" | split: ',' -%}
    {%- assign f_data = '{"S": "39,41,17", "M": "41,43,18", "L": "43,45,18.5", "XL": "45,48,19.5"}' -%}
    {%- assign f_sizes = "S,M,L,XL" | split: ',' -%}
  {%- elsif category == 'shacket' -%}
    {%- assign f_labels = "Sleeve,Chest,Length,Shoulder" | split: ',' -%}
    {%- assign f_data = section.settings.default_shacket_data | default: '{"M": "22.5,43,26,9", "L": "23,45,26.3,9.5", "XL": "23.5,47,26.5,10"}' -%}
    {%- assign f_sizes = "M,L,XL" | split: ',' -%}
  {%- elsif category == 'pants' -%}
    {%- assign f_labels = "Length,Waist,Hip,Knee Opening,Leg Opening" | split: ',' -%}
    {%- assign f_data = section.settings.default_pants_data | default: '{"M": "38,32,41,16,19", "L": "39,34,42,17,20", "XL": "40,36,43,18,21"}' -%}
    {%- assign f_sizes = "M,L,XL" | split: ',' -%}
  {%- else -%}
    {%- assign f_labels = "Chest,Length,Shoulder,Sleeve" | split: ',' -%}
    {%- assign f_data = section.settings.default_panjabi_data | default: '{"S": "38,39,16,22", "M": "40,41,17,23", "L": "42,43,17.5,24", "XL": "44,45,18,25"}' -%}
    {%- if product.tags contains '2xl' -%}
      {%- assign f_sizes = "S,M,L,XL,2XL" | split: ',' -%}
    {%- else -%}
      {%- assign f_sizes = "S,M,L,XL" | split: ',' -%}
    {%- endif -%}
  {%- endif -%}

  <script>
    window.productSpecConfig = {
      labels: {{ f_labels | json }},
      data: {{ f_data }}
    };
    {%- if product.tags contains '2xl' and category == 'panjabi' -%}
    if (!window.productSpecConfig.data['2XL']) {
      window.productSpecConfig.data['2XL'] = '46,46,18.5,25.5';
    }
    {%- endif -%}
  </script>
  <!-- JSON-LD Product Schema for SEO -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "image": [
      {% for image in product.images limit: 3 %}"{{ image | image_url: width: 1200 }}"{% unless forloop.last %},{% endunless %}{% endfor %}
    ],
    "description": {{ product.description | strip_html | truncate: 200 | json }},
    "sku": {{ product.selected_or_first_available_variant.sku | json }},
    "brand": {
      "@type": "Brand",
      "name": {{ shop.name | json }}
    },
    "offers": {
      "@type": "Offer",
      "url": "{{ shop.url }}{{ product.url }}",
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "price": {{ product.price | money_without_currency | json }},
      "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}"
    }
  }
  </script>

  <!-- Left: Image Gallery -->
  <div class="product-gallery">
    <div class="product-gallery__main">
    {%- if product.featured_media -%}
        <div class="product-gallery__image-wrapper">
          {%- for media in product.media -%}
            {%- comment -%} Store variant IDs associated with this media {%- endcomment -%}
            {%- assign media_variant_ids = ',' -%}
            {%- for variant in product.variants -%}
              {%- if variant.featured_media and variant.featured_media.id == media.id -%}
                {%- assign media_variant_ids = media_variant_ids | append: variant.id | append: ',' -%}
              {%- endif -%}
            {%- endfor -%}

            {%- if media.media_type == 'video' -%}
              <div
                class="product-gallery__slide product-gallery__slide--video {% if forloop.first %}is-active{% endif %}"
                data-index="{{ forloop.index0 }}"
                data-media-id="{{ media.id }}"
                data-media-type="video"
                data-variant-ids="{{ media_variant_ids }}"
              >
                {{ media | video_tag: autoplay: false, loop: true, muted: true, controls: true, preload: 'metadata' }}
              </div>
            {%- elsif media.media_type == 'external_video' -%}
              <div
                class="product-gallery__slide product-gallery__slide--video {% if forloop.first %}is-active{% endif %}"
                data-index="{{ forloop.index0 }}"
                data-media-id="{{ media.id }}"
                data-media-type="external_video"
                data-variant-ids="{{ media_variant_ids }}"
              >
                {{ media | external_video_url: autoplay: false, loop: true | external_video_tag }}
              </div>
            {%- else -%}
              <img 
                src="{{ media | image_url: width: 1400 }}" 
                alt="{{ media.alt | escape }}"
                class="product-gallery__slide product-gallery__image {% if forloop.first %}is-active{% endif %}"
                data-index="{{ forloop.index0 }}"
                data-media-id="{{ media.id }}"
                data-media-type="image"
                data-variant-ids="{{ media_variant_ids }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                width="1400"
                height="1400"
              >
            {%- endif -%}
          {%- endfor -%}
          
          {%- if product.media.size > 1 -%}
          <div class="product-gallery__nav">
            <button class="gallery-arrow prev" id="PrevImage" aria-label="Previous image">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m15 18-6-6 6-6"/></svg>
            </button>
            <button class="gallery-arrow next" id="NextImage" aria-label="Next image">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m9 18 6-6-6-6"/></svg>
            </button>
          </div>
          {%- endif -%}
        </div>
    {%- else -%}
        <div class="placeholder-svg">{{ 'product-1' | placeholder_svg_tag }}</div>
    {%- endif -%}
  </div>

    {%- if product.media.size > 1 -%}
    <div class="product-gallery__indicator" id="GalleryStatus">
      <span class="current">1</span> <span class="separator">/</span> <span class="total">{{ product.media.size }}</span>
    </div>
    
    {% comment %}
    <div class="product-gallery__thumbnails" role="tablist" aria-label="Product image gallery">
      {%- for media in product.media -%}
        <div class="gallery-thumbnail {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}">
          <img src="{{ media | image_url: width: 100 }}" alt="{{ media.alt | escape }}" loading="lazy" width="50" height="60">
        </div>
      {%- endfor -%}
    </div>
    {% endcomment %}
        {%- endif -%}

    {%- if featured_video_url != blank -%}
      <div class="product-featured-video product-featured-video--desktop">
        <video 
          src="{{ featured_video_url }}" 
          autoplay 
          loop 
          muted 
          playsinline 
          class="product-featured-video__player"
        ></video>
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} Sale Calculation Logic for Product Page {%- endcomment -%}
{%- assign pp_has_sale = false -%}
{%- assign pp_sale_percentage = 0 -%}
{%- assign pp_original_price = product.price -%}
{%- assign pp_sale_price = product.price -%}
{%- assign pp_auto_discount = 0 -%}

{%- comment -%} Priority 0: Auto-discount (fixed amount off for specific products) {%- endcomment -%}
{%- assign pp_title_lower = product.title | downcase -%}
{%- if pp_title_lower contains 'azraq' or pp_title_lower contains 'nazr' or pp_title_lower contains 'nazar' -%}
  {%- assign pp_auto_discount = 149900 -%}
{%- elsif pp_title_lower contains 'sahara' -%}
  {%- assign pp_auto_discount = 49900 -%}
{%- endif -%}

{%- if pp_auto_discount > 0 -%}
  {%- assign pp_has_sale = true -%}
  {%- assign pp_original_price = product.price -%}
  {%- assign pp_sale_price = product.price | minus: pp_auto_discount -%}
  {%- if pp_sale_price < 0 -%}{%- assign pp_sale_price = 0 -%}{%- endif -%}
  {%- assign pp_sale_percentage = pp_auto_discount | times: 100 | divided_by: product.price -%}
{%- elsif product.compare_at_price > product.price -%}
  {%- assign pp_has_sale = true -%}
  {%- assign pp_original_price = product.compare_at_price -%}
  {%- assign pp_sale_price = product.price -%}
  {%- assign pp_sale_percentage = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
{%- else -%}
  {%- comment -%} Priority 2: Check for sale-XX tag (custom percentage) {%- endcomment -%}
  {%- assign pp_tag_sale_percentage = nil -%}
  {%- assign pp_has_sale_tag = false -%}
  {%- for tag in product.tags -%}
    {%- assign tag_lower = tag | downcase -%}
    {%- if tag_lower contains 'sale-' -%}
      {%- assign tag_parts = tag_lower | split: 'sale-' -%}
      {%- if tag_parts.size > 1 -%}
        {%- assign pp_tag_sale_percentage = tag_parts[1] | plus: 0 -%}
        {%- if pp_tag_sale_percentage > 0 and pp_tag_sale_percentage <= 100 -%}
          {%- assign pp_has_sale = true -%}
          {%- assign pp_sale_percentage = pp_tag_sale_percentage -%}
          {%- assign pp_original_price = product.price -%}
          {%- assign pp_discount_amount = product.price | times: pp_sale_percentage | divided_by: 100.0 -%}
          {%- assign pp_sale_price = product.price | minus: pp_discount_amount | round -%}
          {%- break -%}
        {%- endif -%}
      {%- endif -%}
    {%- elsif tag_lower == 'sale' -%}
      {%- assign pp_has_sale_tag = true -%}
    {%- endif -%}
  {%- endfor -%}

  {%- comment -%} Priority 3: sale tag with global percentage {%- endcomment -%}
  {%- if pp_has_sale == false and pp_has_sale_tag and settings.global_sale_enabled -%}
    {%- assign pp_has_sale = true -%}
    {%- assign pp_sale_percentage = settings.global_sale_percentage -%}
    {%- assign pp_original_price = product.price -%}
    {%- assign pp_discount_amount = product.price | times: pp_sale_percentage | divided_by: 100.0 -%}
    {%- assign pp_sale_price = product.price | minus: pp_discount_amount | round -%}
  {%- endif -%}

  {%- comment -%} Priority 4: Global sale enabled (applies to ALL products) {%- endcomment -%}
  {%- if pp_has_sale == false and settings.global_sale_enabled -%}
    {%- assign pp_has_sale = true -%}
    {%- assign pp_sale_percentage = settings.global_sale_percentage -%}
    {%- assign pp_original_price = product.price -%}
    {%- assign pp_discount_amount = product.price | times: pp_sale_percentage | divided_by: 100.0 -%}
    {%- assign pp_sale_price = product.price | minus: pp_discount_amount | round -%}
  {%- endif -%}
{%- endif -%}

<!-- Right: Product Info -->
  <div class="product-info">
    <div class="product-info__content">
      <div class="product-info__header">
        <h1 class="product-title">{{ product.title }}</h1>
        {%- unless is_sold_out -%}
        <div class="product-price-wrapper">
          <span class="product-price--compare" {% unless pp_has_sale %}style="display:none"{% endunless %}>
            {%- if pp_has_sale -%}{{ pp_original_price | money }}{%- else -%}{{ product.price | money }}{%- endif -%}
          </span>
          <span class="product-price {% if pp_has_sale %}product-price--sale{% endif %}">
            {%- if pp_has_sale -%}{{ pp_sale_price | money }}{%- else -%}{{ product.price | money }}{%- endif -%}
          </span>
          {%- if pp_has_sale and pp_auto_discount > 0 -%}
            <span class="product-price--badge">SAVE {{ pp_auto_discount | money }}</span>
          {%- elsif pp_has_sale and pp_sale_percentage > 0 -%}
            <span class="product-price--badge">-{{ pp_sale_percentage }}%</span>
          {%- else -%}
            <span class="product-price--badge" style="display:none"></span>
          {%- endif -%}
        </div>
        {%- endunless -%}
      </div>


      {%- if is_sold_out -%}
        <div class="sold-out-banner">
          <span class="sold-out-banner__text">SOLD OUT</span>
          <p class="sold-out-banner__sub">This item is no longer available</p>
        </div>
      {%- else -%}

      {%- form 'product', product, id: 'ProductForm' -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" id="VariantId">

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            {%- assign option_name_lower = option.name | downcase -%}
            
            <div class="product-variant-group">
              <div class="variant-label">
                <span>Select {{ option.name }}</span>
                <span class="selected-value">{{ option.selected_value }}</span>
              </div>

              {% if option_name_lower contains 'color' or option_name_lower contains 'colour' %}
                <div class="color-image-swatches">
                {%- for value in option.values -%}
                    {%- assign option_index = forloop.parentloop.index0 -%}
                    {%- assign color_available = false -%}
                    {%- assign variant_for_value = null -%}
                    
                  {%- for variant in product.variants -%}
                      {%- if variant.options[option_index] == value -%}
                        {%- if variant.available -%}
                          {%- assign color_available = true -%}
                        {%- endif -%}
                        {%- if variant_for_value == null and variant.featured_media -%}
                          {%- assign variant_for_value = variant -%}
                        {%- endif -%}
                      {%- endif -%}
                    {%- endfor -%}
                    
                    {%- if variant_for_value == null -%}
                      {%- for variant in product.variants -%}
                        {%- if variant.options[option_index] == value -%}
                           {%- assign variant_for_value = variant -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                    {%- endif -%}
                  
                    <label class="color-image-label {% unless color_available %}is-unavailable{% endunless %}">
                      <input type="radio" 
                             name="options[{{ option.name }}]" 
                             value="{{ value | escape }}" 
                             data-index="{{ forloop.parentloop.index0 }}"
                             data-variant-id="{% if variant_for_value %}{{ variant_for_value.id }}{% endif %}"
                             {% if option.selected_value == value %}checked{% endif %}
                             class="visually-hidden color-radio">
                             
                      <div class="color-image-box" title="{{ value }}{% unless color_available %} (Sold Out){% endunless %}">
                        {%- if variant_for_value.featured_media -%}
                          <img src="{{ variant_for_value.featured_media | image_url: width: 100 }}" alt="{{ value }}" loading="lazy" width="100" height="100">
                        {%- else -%}
                          <span class="color-name">{{ value | truncate: 3, '' }}</span>
                        {%- endif -%}
                      </div>
                    </label>
                {%- endfor -%}
              </div>
              {% elsif option_name_lower contains 'size' or option_name_lower contains 'waist' %}
                <div class="size-slider-grid">
                  {%- for value in option.values -%}
                    {%- assign size_available = false -%}
                    {%- assign option_position = forloop.parentloop.index0 -%}
                    {%- for variant in product.variants -%}
                      {%- if variant.options[option_position] == value and variant.available -%}
                        {%- assign size_available = true -%}
                        {%- break -%}
                      {%- endif -%}
                    {%- endfor -%}

                    
                    <label class="size-slider-item {% unless size_available %}is-unavailable{% endunless %}">
                      <input type="radio" 
                             name="options[{{ option.name }}]" 
                             value="{{ value | escape }}" 
                             data-index="{{ forloop.parentloop.index0 }}"
                             {% comment %} Removed auto-select {% if option.selected_value == value %}checked{% endif %} {% endcomment %} 
                             class="visually-hidden size-radio">
                      <div class="size-slider-box">
                        <span class="size-slider-text">{{ value }}</span>
                      </div>
                    </label>
                  {%- endfor -%}
                </div>
                <div class="size-specs-display" id="SizeSpecsDisplay">
                  <div class="specs-placeholder">CHOOSE YOUR SIZE</div>
                </div>
              {% else %}
                <div class="standard-variant-selector">
                  <select name="options[{{ option.name }}]" class="variant-select" data-index="{{ forloop.index0 }}">
                    {%- for value in option.values -%}
                      <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                    {%- endfor -%}
                  </select>
                </div>
              {% endif %}
            </div>
          {%- endfor -%}
        {%- endunless -%}


        {%- if settings.show_stock_indicator and is_sold_out == false -%}
            <div class="low-stock-warning" id="LowStockWarning" style="display:none;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
              <span id="LowStockText"></span>
            </div>
        {%- endif -%}

        {%- if settings.enable_whatsapp_ordering -%}
          <a id="WhatsAppOrderBtn" href="#" class="add-to-cart-btn" style="background: #25D366; color: #fff;" target="_blank" rel="noopener noreferrer">
            BOOK NOW
          </a>
        {%- else -%}
          <button type="submit" name="add" class="add-to-cart-btn">
            {{ 'product.add_to_cart' | t | upcase }}
          </button>
        {%- endif -%}
      {%- endform -%}
      {% render 'prepayment-popup', product: product %}

      {%- if featured_video_url != blank -%}
        <div class="product-featured-video product-featured-video--mobile">
          <video 
            src="{{ featured_video_url }}" 
            autoplay 
            loop 
            muted 
            playsinline 
            class="product-featured-video__player"
          ></video>
        </div>
      {%- endif -%}
      {%- endif -%}

      <!-- Accordions -->
      <div class="product-info__accordions">
        <details class="accordion-item" open>
          <summary>
            <div class="summary-left">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 8V21H3V8M1 3H23V8H1V3ZM10 12H14"/></svg>
            <span>Product Details</span>
            </div>
            <span class="accordion-icon">−</span>
          </summary>
          <div class="accordion-content">
            {{ product.description }}
          </div>
        </details>

        <details class="accordion-item">
          <summary>
            <div class="summary-left">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 3.13a4 4 0 0 1 0 7.75M7 19.88a9 9 0 1 1 10 0M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z"/></svg>
              <span>Size Guide</span>
            </div>
            <span class="accordion-icon">+</span>
          </summary>
          <div class="accordion-content">
            {%- comment -%} 3. Determine Visuals & Data {%- endcomment -%}
            {%- assign matching_guide = nil -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'size_guide' -%}
                {%- assign trigger = block.settings.trigger_type | downcase -%}
                {%- if p_type contains trigger or p_title contains trigger -%}
                  {%- assign matching_guide = block -%}
                  {%- break -%}
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}


            {%- comment -%} 4. Render Layout {%- endcomment -%}
            <div class="size-guide-visual" style="margin-bottom: 20px; text-align: center;">
              {%- if matching_guide and matching_guide.settings.guide_image != blank -%}
                {{ matching_guide.settings.guide_image | image_url: width: 800 | image_tag: alt: "Size Guide Visual", loading: "lazy", width: 800, height: 800, style: "width: 100%; max-width: 400px; height: auto; display: inline-block;" }}
              {%- else -%}
                {%- if category == 'shacket' -%}
                  <img src="{{ 'shacket.svg' | asset_url }}" alt="Size Guide Visual" loading="lazy" width="800" height="800" style="width: 100%; max-width: 400px; height: auto; display: inline-block;">
                {%- elsif category == 'pants' -%}
                  <img src="{{ 'pants.svg' | asset_url }}" alt="Size Guide Visual" loading="lazy" width="800" height="800" style="width: 100%; max-width: 400px; height: auto; display: inline-block;">
                {%- elsif category == 'eden' -%}
                  {%- comment -%} No generic SVG for Eden, we rely on the dynamic table below {%- endcomment -%}
                {%- else -%}
                  <img src="{{ 'panjabi size chart.svg' | asset_url }}" alt="Size Guide Visual" loading="lazy" width="800" height="800" style="width: 100%; max-width: 400px; height: auto; display: inline-block;">
                {%- endif -%}
              {%- endif -%}
            </div>

            <div class="size-unit-toggle" style="margin-bottom: 15px; text-align: right;">
              <button type="button" class="unit-btn active" data-unit="in" style="font-size: 10px; padding: 4px 8px; border: 1px solid #000; background: #000; color: #fff; cursor: pointer;">INCH</button>
              <button type="button" class="unit-btn" data-unit="cm" style="font-size: 10px; padding: 4px 8px; border: 1px solid #000; background: transparent; color: #000; cursor: pointer; margin-left: -1px;">CM</button>
            </div>

            {%- if matching_guide -%}
               {{ matching_guide.settings.guide_content }}
               {%- if matching_guide.settings.spec_data != blank -%}
                 {%- assign f_labels = matching_guide.settings.spec_labels | split: ',' -%}
                 {%- assign f_data = matching_guide.settings.spec_data -%}
                 {%- assign f_sizes = nil -%} {%- comment -%} Show all keys if block is used {%- endcomment -%}
               {%- endif -%}
            {%- endif -%}

            {%- assign p_title_downcase = product.title | downcase -%}
            {%- assign p_tags_down_string = product.tags | join: ',' | downcase -%}
            {%- if p_title_downcase contains 'ameer' -%}
              {%- assign f_data = '{"S": "38,37,16,22", "M": "40,39,17,23", "L": "42,41,17.5,24", "XL": "44,43,18,25"}' -%}
            {%- elsif p_title_downcase contains 'eden' or p_title_downcase contains 'edan' or p_tags_down_string contains 'eden' or p_tags_down_string contains 'edan' -%}
              {%- assign f_data = '{"S": "39,41,17,22.75", "M": "41,43,18,23.5", "L": "43,45,18.5,23.75", "XL": "45,48,19.5,26"}' -%}
              {%- assign f_labels = "Length,Chest,Shoulder,Sleeve" | split: ',' -%}
              {%- assign f_sizes = "S,M,L,XL" | split: ',' -%}
            {%- endif -%}

            <div class="size-chart-automatic">
              <table class="size-guide-table">
                <thead>
                  <tr>
                    <th>SIZE</th>
                    {%- for label in f_labels -%}
                      <th>{{ label | strip | upcase }}</th>
                    {%- endfor -%}
                  </tr>
                </thead>
                <tbody id="SizeChartBody-{{ section.id }}"></tbody>
              </table>
            </div>

            <script>
              (function() {
                const labels = {{ f_labels | json }};
                const data = {{ f_data }};
                {%- if product.tags contains '2xl' and category == 'panjabi' -%}
                if (!data['2XL']) {
                  data['2XL'] = '46,46,18.5,25.5';
                }
                {%- endif -%}
                window.productSpecConfig = { labels, data };
                
                const tbody = document.getElementById('SizeChartBody-{{ section.id }}');
                if (!tbody) return;
                
                let html = '';
                const f_sizes = {{ f_sizes | json }};
                
                if (f_sizes) {
                  f_sizes.forEach(size => {
                    const values = data[size];
                    if (values) {
                      html += `<tr><td><strong>${size}</strong></td>`;
                      values.split(',').forEach(v => {
                        html += `<td><span class="size-val" data-inch="${v.trim()}">${v.trim()}</span></td>`;
                      });
                      html += '</tr>';
                    }
                  });
                } else {
                  // Fallback to all keys if no specific sizes defined (block override)
                  for (const [size, values] of Object.entries(data)) {
                    html += `<tr><td><strong>${size}</strong></td>`;
                    values.split(',').forEach(v => {
                      html += `<td><span class="size-val" data-inch="${v.trim()}">${v.trim()}</span></td>`;
                    });
                    html += '</tr>';
                  }
                }
                tbody.innerHTML = html;
              })();
            </script>
          </div>
        </details>

        <details class="accordion-item">
          <summary>
            <div class="summary-left">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 3H15V17H1V3ZM15 8H23V17H15V8ZM5 17V21M11 17V21M19 17V21"/></svg>
              <span>{{ section.settings.shipping_returns_title | default: 'Shipping and Returns' }}</span>
            </div>
            <span class="accordion-icon">+</span>
          </summary>
          <div class="accordion-content">
            {{ section.settings.shipping_returns_content | default: '<p>Free Standard delivery within 3-5 business days. Return is accepted within 24 hours past delivery and is subjected to the Return and Exchange Policy.</p>' }}
          </div>
        </details>


        </div>
      </div>
    </div>
  </div>

  <!-- Recommendations Section -->
{%- if section.settings.show_recommendations -%}
<div class="product-recommendations" style="margin-top: 100px; margin-bottom: 120px;" data-url="{{ routes.product_recommendations_url }}?section_id=product-grid&product_id={{ product.id }}&limit=4">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">
        {%- if settings.recommendations_title != blank -%}
          {{ settings.recommendations_title }}
        {%- else -%}
          {{ 'product.you_may_also_like' | t }}
        {%- endif -%}
      </h2>
    </div>
      <div class="product-grid" id="RecommendationsGrid">
        <!-- JS will populate this -->
      </div>
    </div>
  </div>
{%- endif -%}

<script type="application/json" id="ProductJson">
  {{ product | json }}
</script>

<script type="application/json" id="VariantInventoryJson">
  {
    {%- for variant in product.variants -%}
      "{{ variant.id }}": {{ variant.inventory_quantity | default: 0 }}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  }
</script>

<script type="application/json" id="SaleConfig">
{
  "globalSaleEnabled": {{ settings.global_sale_enabled | json }},
  "globalSalePercentage": {{ settings.global_sale_percentage | json }},
  "showSalePercentage": {{ settings.show_sale_percentage | json }},
  "productTags": {{ product.tags | json }},
  "hasNativeCompareAt": {{ product.compare_at_price | default: 0 | json }}
}
</script>

{%- if settings.enable_whatsapp_ordering -%}
<script type="application/json" id="WhatsAppConfig">
{
  "phoneNumber": {{ settings.whatsapp_number | default: '+8801341630198' | json }},
  "messageTemplate": {{ settings.whatsapp_message_template | json }},
  "productTitle": {{ product.title | json }},
  "productUrl": {{ product.url | absolute_url | json }}
}
</script>
{%- endif -%}

{% stylesheet %}
/* Override skeleton theme margins for product page */
/* Clear overlap and handle header background */
/* Natural Document Flow - Make Header Static on Product Page */
body.template-product .announcement-bar,
body.template-product .header-wrapper {
  position: relative !important;
  top: 0 !important;
  left: 0 !important;
  width: 100% !important;
  z-index: 10001 !important;
}

body.template-product .header-wrapper {
  background: var(--header-bg, #efebe0) !important;
  opacity: 1 !important;
  visibility: visible !important;
  box-shadow: 0 4px 20px rgba(0,0,0,0.05) !important;
  transform: none !important; /* Prevent scroll-hide interference */
}

/* Ensure announcement bar keeps its own color */
body.template-product .announcement-bar {
  background: var(--announcement-bg, #000) !important;
  color: var(--announcement-text, #fff) !important;
  margin-bottom: 0 !important;
}

body.template-product .header,
body.template-product .header__menu-item,
body.template-product .header__logo-text,
body.template-product .header__icon-svg {
  color: var(--header-text, #3D2500) !important;
}

/* Base Product Page Layout */
body.template-product .product-page {
  display: flex;
  min-height: 80vh;
  margin: 0 auto !important;
  padding-top: 40px !important; /* Smaller padding now that it's in flow */
  padding-bottom: 120px !important;
  width: 100%;
  max-width: 100% !important;
  background: #efebe0;
  gap: 80px; 
  margin-bottom: 100px !important;
}

/* Ensure MainContent doesn't add extra gaps */
body.template-product main#MainContent {
  padding-top: 0 !important;
  margin-top: 0 !important;
}

/* Sync Gallery and Info vertical start */
.product-gallery,
.product-info {
  padding-top: 0 !important; /* Managed by parent container */
}

@media (max-width: 900px) {
  .product-page { 
    flex-direction: column; 
    gap: 40px; /* Vertical gap on mobile */
  }
}

/* Gallery Side */
.product-gallery {
  flex: 1.5;
  position: relative;
  background: #efebe0;
  border-right: 1px solid rgba(0,0,0,0.05);
  padding: 0;
}

.product-gallery__image {
  background: transparent !important;
}

.product-gallery__image-wrapper::before,
.product-gallery__image-wrapper::after {
  display: none !important;
  background: transparent !important;
}

@media (max-width: 900px) {
.product-gallery {
    min-height: 80vh;
    border-right: none;
    border-bottom: 1px solid #eee;
  }
}

.product-gallery__main {
  position: relative;
  min-height: 70vh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 0;
}

@media (max-width: 900px) {
  .product-gallery__main {
    height: 80vh;
    position: relative;
  }
}

.product-gallery__image-wrapper {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #efebe0;
}

.product-gallery__image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  opacity: 0;
  transition: opacity 0.4s ease;
  background: transparent;
}

.product-gallery__image.is-active {
  opacity: 1;
  position: relative;
  top: auto;
  left: auto;
  transform: none;
  width: 100%;
  height: 100%;
}

/* Video slides */
.product-gallery__slide--video {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  transition: opacity 0.4s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #efebe0;
}

.product-gallery__slide--video.is-active {
  opacity: 1;
  position: relative;
  top: auto;
  left: auto;
  width: 100%;
  height: 100%;
}

.product-gallery__slide--video video,
.product-gallery__slide--video iframe {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.product-gallery__nav {
  position: absolute;
  top: 50%;
  width: 100%;
  display: flex;
  justify-content: space-between;
  padding: 0 40px;
  transform: translateY(-50%);
  z-index: 10;
  pointer-events: none;
}

.gallery-arrow {
  background: #efebe0;
  border: 1px solid rgba(0,0,0,0.1);
  width: 44px;
  height: 44px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  opacity: 0;
  transition: all 0.3s;
  pointer-events: auto;
}

.product-gallery:hover .gallery-arrow {
  opacity: 0.8;
}

.gallery-arrow:hover { opacity: 1 !important; transform: scale(1.1); }

.product-gallery__indicator {
  position: absolute;
  bottom: 40px;
  left: 20px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 1px;
  color: #1a1a1a;
}

@media (max-width: 900px) {
  .product-gallery__indicator {
    display: none;
  }
}

.product-gallery__thumbnails {
  position: absolute;
  bottom: 40px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 12px;
  z-index: 20;
}

.gallery-thumbnail {
  width: 50px;
  height: 60px;
  border: 1px solid rgba(0,0,0,0.1);
  cursor: pointer;
  transition: all 0.3s ease;
  background: #efebe0;
  padding: 2px;
  overflow: hidden;
}

.gallery-thumbnail.is-active {
  border-color: #000;
  transform: translateY(-4px);
  box-shadow: 0 5px 15px rgba(0,0,0,0.1);
}

.gallery-thumbnail img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Product Status Info */
.product-status-info {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 30px;
}

.status-indicator {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  position: relative;
}

.status-indicator.available { background: #000; }
.status-indicator.available::after {
  content: '';
  position: absolute;
  top: -2px;
  left: -2px;
  right: -2px;
  bottom: -2px;
  border-radius: 50%;
  border: 1px solid #000;
  animation: pulse 2s infinite;
}

.status-indicator.out-of-stock { background: #ff0000; }

@keyframes pulse {
  0% { transform: scale(1); opacity: 1; }
  100% { transform: scale(2.5); opacity: 0; }
}

.status-text {
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 2px;
  color: #000;
}

/* Info Side */
.product-info {
  flex: 1;
  padding: 0 8% 80px 0; /* Removed top padding to sync with gallery */
  background: #efebe0;
  border-left: none; /* Removed border for a cleaner, open look */
}

@media (max-width: 900px) {
  .product-info { padding: 30px 20px 60px; border-left: none; }
  .product-title { font-size: 24px; margin-bottom: 8px; }
  .product-price { font-size: 20px; }
  .product-price--compare { font-size: 14px; }
  .product-price--badge { font-size: 9px; padding: 3px 7px; }
  .product-price-wrapper { gap: 8px; }
}

.product-info__header {
  display: flex;
  flex-direction: column;
  gap: 16px;
  margin-bottom: 30px;
}

.product-title {
  font-size: 36px;
  font-weight: 500;
  margin: 0 0 16px;
  line-height: 1.2;
  color: #1a1a1a;
  letter-spacing: -0.03em;
  flex: 1;
}

.product-price-wrapper {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 10px;
  flex-wrap: wrap;
}

.product-price {
  font-size: 28px;
  font-weight: 600;
  margin: 0;
  color: #1a1a1a;
  letter-spacing: -0.01em;
}

/* Sold Out Refinement */
.product-page.is-sold-out .product-gallery {
  pointer-events: none;
  filter: grayscale(100%);
}

.product-page.is-sold-out .status-indicator.out-of-stock {
  background: #ff0000;
  box-shadow: 0 0 10px rgba(255, 0, 0, 0.5);
}

.product-page.is-sold-out .status-text {
  color: #ff0000;
}

.sold-out-banner {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6px;
  padding: 20px 24px;
  border: 2px solid #c0392b;
  background: #fff5f5;
  margin: 8px 0 16px;
}

.sold-out-banner__text {
  font-size: 22px;
  font-weight: 800;
  letter-spacing: 3px;
  color: #c0392b;
}

.sold-out-banner__sub {
  font-size: 12px;
  color: #999;
  letter-spacing: 0.5px;
  text-transform: uppercase;
}


.product-price--compare {
  font-size: 14px;
  color: #999;
  text-decoration: line-through;
  text-decoration-color: #c00;
}

.product-price--sale {
  color: #c00 !important;
  font-weight: 600;
}

.product-price--badge {
  display: inline-block;
  background: #c00;
  color: #fff;
  font-size: 10px;
  font-weight: 700;
  padding: 3px 8px;
  letter-spacing: 0.5px;
  vertical-align: middle;
  text-transform: uppercase;
  white-space: nowrap;
}

/* Variant Groups */
.product-variant-group {
  margin-bottom: 40px;
}

.variant-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 10px;
  font-weight: 600;
  text-transform: uppercase;
  margin-bottom: 12px;
  color: #000;
  letter-spacing: 1.5px;
}

.selected-value { color: #888; font-weight: 400; }

/* Color Image Swatches */
.color-image-swatches {
  display: flex;
  gap: 12px;
  padding: 12px;
  background: #efebe0;
  width: fit-content;
  border: 1px solid #d8d4c9;
  border-radius: 4px;
}

.color-image-label {
  position: relative;
}

.color-image-box {
  width: 50px;
  height: 65px;
  cursor: pointer;
  transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
  background: #efebe0;
  overflow: hidden;
  border: 2px solid transparent;
  border-radius: 4px;
  position: relative;
}

.color-image-box img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s cubic-bezier(0.23, 1, 0.32, 1);
}

.color-image-box:hover {
  transform: translateY(-4px);
  box-shadow: 0 10px 25px rgba(0,0,0,0.1);
}

.color-image-box:hover img {
  transform: scale(1.1);
}

input:checked + .color-image-box {
  border-color: #000;
  box-shadow: 0 0 0 1px #000;
}

/* Color Tooltip */
.color-tooltip {
  position: absolute;
  bottom: 100%;
  left: 50%;
  transform: translateX(-50%) translateY(-8px);
  background: #000;
  color: #fff;
  padding: 6px 12px;
  font-size: 10px;
  font-weight: 600;
  text-transform: uppercase;
  white-space: nowrap;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease, transform 0.3s ease;
  z-index: 100;
  border-radius: 4px;
  letter-spacing: 0.5px;
}

.color-tooltip::after {
  content: '';
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%);
  border: 4px solid transparent;
  border-top-color: #000;
}

.color-image-box:hover .color-tooltip {
  opacity: 1;
  transform: translateX(-50%) translateY(-12px);
}

.color-name {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  background: #f0f0f0;
  color: #333;
}

/* Size Slider Grid */
.size-guide-pill {
  background: #e0e0e0;
  border: none;
  padding: 6px 14px;
  border-radius: 20px;
  font-size: 9px;
  font-weight: 700;
  text-transform: uppercase;
  cursor: pointer;
  letter-spacing: 0.5px;
  transition: background 0.2s;
}

.size-guide-pill:hover {
  background: #d0d0d0;
}

.size-slider-grid {
  display: flex;
  flex-wrap: wrap; /* Prevent cramping on small screens */
  width: 100%;
  background: transparent;
  padding: 10px 15px;
  border: 1px solid #d8d4c9;
  border-radius: 2px;
  margin: 10px 0 25px 0;
  align-items: center;
  justify-content: center;
  gap: 20px;
  box-sizing: border-box;
}

@media (max-width: 600px) {
  .size-slider-grid {
    gap: 15px;
    padding: 8px 10px;
  }
}

.size-slider-item {
  flex: 1 1 auto;
  min-width: 40px;
  position: relative;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}

@media (max-width: 600px) {
  .size-slider-item {
    min-width: 36px;
  }
}

.size-slider-box {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.size-slider-text {
  display: inline-block;
  padding: 12px 0;
  font-size: 16px;
  font-weight: 600;
  color: #333;
  text-transform: uppercase;
  letter-spacing: 2px;
  transition: all 0.3s ease;
  position: relative;
}

/* The Underline */
.size-slider-text::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 2px;
  background: #000;
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
}

/* Selected State - Show Underline */
.size-radio:checked + .size-slider-box .size-slider-text::after {
  transform: scaleX(1);
}

.size-radio:checked + .size-slider-box .size-slider-text {
  color: #000;
  font-weight: 800;
}

/* Hover effect */
.size-slider-item:hover:not(.is-unavailable) .size-slider-text::after {
  transform: scaleX(1);
  opacity: 0.5; /* Subtle underline on hover */
}

.size-radio:checked + .size-slider-box .size-slider-text::after {
  opacity: 1 !important; /* Full underline on select */
}

.size-slider-item.is-unavailable .size-slider-text {
  color: #ccc;
  text-decoration: line-through;
}

.color-image-label.is-unavailable .color-image-box {
  opacity: 0.4;
  position: relative;
}

.color-image-label.is-unavailable .color-image-box::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  height: 1px;
  background: #000;
  transform: rotate(-45deg);
}

/* Low Stock Warning */
.low-stock-warning {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 16px;
  background: #fff3e0;
  border: 1px solid #ffcc80;
  border-radius: 4px;
  margin-bottom: 16px;
  font-size: 13px;
  font-weight: 600;
  color: #e65100;
}

.low-stock-warning svg {
  flex-shrink: 0;
  color: #e65100;
}

/* Quantity Selector */
.product-quantity-wrapper {
  margin-bottom: 20px;
}

.quantity-label {
  display: block;
  font-size: 10px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  margin-bottom: 12px;
}

.product-quantity {
  display: inline-flex;
  align-items: center;
  border: 1px solid #ddd;
}

.product-quantity .qty-btn {
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  background: none;
  border: none;
  cursor: pointer;
  transition: background 0.2s;
  color: #1a1a1a;
}

.product-quantity .qty-btn:hover {
  background: #f5f5f5;
}

.product-quantity .qty-input {
  width: 60px;
  height: 48px;
  text-align: center;
  border: none;
  border-left: 1px solid #ddd;
  border-right: 1px solid #ddd;
  font-size: 16px;
  font-weight: 500;
  -webkit-appearance: none;
  -moz-appearance: none;
  appearance: none;
}

.product-quantity .qty-input::-webkit-outer-spin-button,
.product-quantity .qty-input::-webkit-inner-spin-button {
  -webkit-appearance: none;
  margin: 0;
}

/* Accordions */
.product-info__accordions {
  margin-top: 40px;
  border-top: 1px solid #f0f0f0;
}

.accordion-item {
  border-bottom: 1px solid #f0f0f0;
}

.accordion-item summary {
  padding: 24px 0;
  list-style: none;
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
}

.accordion-item summary::-webkit-details-marker {
  display: none;
}

.summary-left {
  display: flex;
  align-items: center;
  gap: 15px;
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.accordion-icon {
  font-size: 20px;
  font-weight: 300;
  color: #999;
  transition: transform 0.3s;
}

.accordion-item[open] .accordion-icon {
  transform: rotate(45deg);
}

.accordion-content {
  padding-bottom: 30px;
  font-size: 13px;
  line-height: 1.6;
  color: #666;
}

/* Add to Cart Button */
.add-to-cart-btn {
  display: none; /* Hidden by default until selection */
  width: 100%;
  background: #1a1a1a;
  color: #efebe0;
  border: none;
  padding: 18px 30px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 2px;
  text-transform: uppercase;
  cursor: pointer;
  transition: all 0.3s ease;
  margin-top: 10px;
}

.add-to-cart-btn:hover:not(:disabled) {
  background: #333;
}

.add-to-cart-btn:disabled {
  background: #ccc;
  color: #888;
  cursor: not-allowed;
}

/* Recommendations */
.product-recommendations {
  margin-top: 100px;
  padding: 80px 0;
  border-top: 1px solid rgba(0,0,0,0.05);
  background: #efebe0;
}

.product-recommendations .container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 40px;
}

.section-header {
  text-align: center;
  margin-bottom: 50px;
}

.section-title {
  font-size: 14px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 2px;
  color: #1a1a1a;
}

/* Standardize product grid for recommendations */
.product-recommendations .product-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
}

@media (max-width: 1024px) {
  .product-recommendations .product-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (max-width: 768px) {
  .product-recommendations .product-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  margin: -1px;
  padding: 0;
  overflow: hidden;
  clip: rect(0,0,0,0);
  border: 0;
}

/* Size Specs Display Box */
.size-specs-display {
  margin-top: 30px;
  padding: 0;
  background: #1a1a1a;
  color: #efebe0;
  border-radius: 4px;
  min-height: 60px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
  opacity: 1;
  visibility: visible;
  border: 1px solid rgba(239, 235, 224, 0.2);
  overflow: hidden;
  position: relative;
  z-index: 50;
  width: 100%;
  box-sizing: border-box;
}

.size-specs-display.is-hovering {
  transform: translateY(-8px);
  box-shadow: 0 20px 40px rgba(0,0,0,0.4);
  background: #222;
  border-color: #efebe0;
}

.specs-placeholder {
  font-size: 10px;
  color: rgba(239, 235, 224, 0.4);
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  text-align: center;
}

.size-specs-display.has-content {
  padding: 25px;
  min-height: 100px;
  height: auto;
  opacity: 1;
  visibility: visible;
  flex-direction: column;
}


.specs-current-size {
  font-size: 11px;
  font-weight: 700;
  color: #efebe0;
  margin-bottom: 20px;
  letter-spacing: 3px;
  text-transform: uppercase;
  width: 100%;
  text-align: center;
  padding-bottom: 12px;
  border-bottom: 1px solid rgba(239, 235, 224, 0.15);
}

.specs-grid {
  display: flex;
  flex-wrap: wrap;
  width: 100%;
  justify-content: space-evenly;
  gap: 15px;
}

@media (max-width: 600px) {
  .specs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px 10px;
  }
}

.spec-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
}

.spec-label {
  font-size: 10px;
  font-weight: 600;
  color: rgba(239, 235, 224, 0.6);
  text-transform: uppercase;
  letter-spacing: 1px;
}

.spec-value {
  font-size: 18px;
  font-weight: 700;
  color: #efebe0;
}

/* Size Guide Table */
.size-chart-table-wrapper {
  overflow-x: auto;
  margin-top: 10px;
}

.size-chart-automatic {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.size-guide-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12px;
  text-align: left;
  min-width: 320px;
}

.size-guide-table th {
  padding: 12px 10px;
  border-bottom: 2px solid #000;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 1px;
  font-size: 10px;
  white-space: nowrap;
}

.size-guide-table td {
  padding: 12px 10px;
  border-bottom: 1px solid #eee;
  color: #444;
  white-space: nowrap;
}

.size-guide-table tr:hover td {
  background: #fafafa;
}

.size-guide-table strong {
  color: #000;
}

@media (max-width: 600px) {
  .size-guide-table {
    font-size: 11px;
  }
  .size-guide-table th,
  .size-guide-table td {
    padding: 10px 8px;
  }
}

/* Custom Select Styling */
.standard-variant-selector {
  position: relative;
  width: 100%;
}

.variant-select {
  appearance: none;
  -webkit-appearance: none;
  background-color: transparent;
  border: 1px solid #d8d4c9;
  border-radius: 2px;
  padding: 14px 40px 14px 16px;
  width: 100%;
  font-family: inherit;
  font-size: 13px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: #1a1a1a;
  cursor: pointer;
  background-image: url("data:image/svg+xml;charset=US-ASCII,%3Csvg%20width%3D%2224%22%20height%3D%2224%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22black%22%20stroke-width%3D%221.5%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cpath%20d%3D%22M6%209l6%206%206-6%22%2F%3E%3C%2Fsvg%3E");
  background-repeat: no-repeat;
  background-position: right 12px center;
  background-size: 16px;
  transition: all 0.2s ease;
}

.variant-select:hover {
  border-color: #000;
}

.variant-select:focus {
  outline: none;
  border-color: #000;
  background-color: #fff;
}
{% endstylesheet %}

<script>
// Expose translations to JavaScript
window.productTranslations = {
  addToCart: {{ 'product.add_to_cart' | t | json }},
  soldOut: {{ 'product.sold_out' | t | json }},
  inStock: {{ 'product.in_stock' | t | json }},
  adding: 'ADDING...',
  added: 'ADDED ✓',
  error: 'ERROR',
  tryAgain: 'TRY AGAIN'
};

document.addEventListener('DOMContentLoaded', () => {
  // Gallery Logic
  const slides = document.querySelectorAll('.product-gallery__slide');
  const dots = document.querySelectorAll('.gallery-thumbnail');
  const status = document.getElementById('GalleryStatus');
  const prev = document.getElementById('PrevImage');
  const next = document.getElementById('NextImage');
  let current = 0;

  function pauseAllMedia() {
    document.querySelectorAll('.product-gallery video').forEach(v => v.pause());
  }

  if (slides.length > 1) {
    const update = (index) => {
      pauseAllMedia();
      slides.forEach(slide => slide.classList.remove('is-active'));
      dots.forEach(dot => dot.classList.remove('is-active'));
      
      current = (index + slides.length) % slides.length;
      slides[current].classList.add('is-active');
      if (dots[current]) dots[current].classList.add('is-active');
      if (status) {
        const currentSpan = status.querySelector('.current');
        if (currentSpan) currentSpan.textContent = current + 1;
      }
    };

    // Make update function available for variant switching
    window.updateGalleryImage = update;

    if (prev) prev.addEventListener('click', () => update(current - 1));
    if (next) next.addEventListener('click', () => update(current + 1));
    
    dots.forEach((dot, idx) => {
      dot.addEventListener('click', () => update(idx));
    });
  }

  // Variant Selection Logic
  let productForm = document.getElementById('ProductForm');
  if (!productForm) {
    productForm = document.querySelector('form[action*="/cart/add"]');
  }
  
  if (productForm) {
    const productJson = document.getElementById('ProductJson');
    if (!productJson) return;

    const product = JSON.parse(productJson.textContent);
    const variants = product.variants;
    const idInput = document.getElementById('VariantId');
    const priceDisplay = document.querySelector('.product-price');
    const comparePriceDisplay = document.querySelector('.product-price--compare');
    const statusText = document.querySelector('.status-text');
    const statusIndicator = document.querySelector('.status-indicator');
    const addToCartBtn = document.querySelector('.add-to-cart-btn');
    const labels = productForm.querySelectorAll('.selected-value');
    const lowStockWarning = document.getElementById('LowStockWarning');
    const lowStockText = document.getElementById('LowStockText');
    const variantInventoryEl = document.getElementById('VariantInventoryJson');
    const variantInventory = variantInventoryEl ? JSON.parse(variantInventoryEl.textContent) : {};
    const lowStockThreshold = {{ settings.low_stock_threshold | default: 5 }};

    // Sale configuration
    const saleConfigEl = document.getElementById('SaleConfig');
    const saleConfig = saleConfigEl ? JSON.parse(saleConfigEl.textContent) : {
      globalSaleEnabled: false,
      globalSalePercentage: 10,
      showSalePercentage: true,
      productTags: [],
      hasNativeCompareAt: 0
    };

    // Auto-discount amounts (fixed ৳ off, stored in paisa/cents)
    const autoDiscountAmountMap = {
      'azraq': 149900,
      'nazr': 149900,
      'nazar': 149900,
      'sahara': 49900
    };
    const autoDiscountCodes = {
      'azraq': '4SDVX4ZZVC5R',
      'nazr': 'GN4VQXX0886V',
      'nazar': 'GN4VQXX0886V',
      'sahara': 'D4NMDJ6PHZD9'
    };
    const productTitleLowerForDiscount = {{ product.title | downcase | json }};
    let autoDiscountAmount = 0;
    let autoDiscountCode = '';
    for (const [name, amount] of Object.entries(autoDiscountAmountMap)) {
      if (productTitleLowerForDiscount.includes(name)) {
        autoDiscountAmount = amount;
        autoDiscountCode = autoDiscountCodes[name] || '';
        break;
      }
    }
    // Expose for cart drawer
    window.__autoDiscountAmount = autoDiscountAmount;
    window.__autoDiscountCode = autoDiscountCode;

    // Function to calculate sale price for a variant
    const calculateSalePrice = (variant) => {
      let hasSale = false;
      let salePercentage = 0;
      let originalPrice = variant.price;
      let salePrice = variant.price;

      // Priority 0: Auto-discount (fixed amount off for specific products)
      if (autoDiscountAmount > 0) {
        const discountedPrice = variant.price - autoDiscountAmount;
        if (discountedPrice > 0) {
          return {
            hasSale: true,
            originalPrice: variant.price,
            salePrice: discountedPrice,
            salePercentage: Math.round(autoDiscountAmount * 100 / variant.price)
          };
        }
      }

      // Priority 1: Native compare_at_price
      if (variant.compare_at_price && variant.compare_at_price > variant.price) {
        return {
          hasSale: true,
          originalPrice: variant.compare_at_price,
          salePrice: variant.price,
          salePercentage: Math.round((variant.compare_at_price - variant.price) * 100 / variant.compare_at_price)
        };
      }

      // Priority 2: Check for sale-XX tag (custom percentage)
      let tagSalePercentage = null;
      let hasSaleTag = false;

      for (const tag of saleConfig.productTags) {
        const tagLower = tag.toLowerCase();
        if (tagLower.includes('sale-')) {
          const parts = tagLower.split('sale-');
          if (parts.length > 1) {
            const pct = parseInt(parts[1], 10);
            if (pct > 0 && pct <= 100) {
              tagSalePercentage = pct;
              break;
            }
          }
        } else if (tagLower === 'sale') {
          hasSaleTag = true;
        }
      }

      if (tagSalePercentage !== null) {
        hasSale = true;
        salePercentage = tagSalePercentage;
        originalPrice = variant.price;
        salePrice = Math.round(variant.price * (1 - salePercentage / 100));
      }
      // Priority 3: sale tag with global percentage
      else if (hasSaleTag && saleConfig.globalSaleEnabled) {
        hasSale = true;
        salePercentage = saleConfig.globalSalePercentage;
        originalPrice = variant.price;
        salePrice = Math.round(variant.price * (1 - salePercentage / 100));
      }
      // Priority 4: Global sale enabled
      else if (saleConfig.globalSaleEnabled) {
        hasSale = true;
        salePercentage = saleConfig.globalSalePercentage;
        originalPrice = variant.price;
        salePrice = Math.round(variant.price * (1 - salePercentage / 100));
      }

      return { hasSale, originalPrice, salePrice, salePercentage };
    };

    const formatMoney = (cents) => {
      if (typeof Shopify !== 'undefined' && Shopify.formatMoney) {
        return Shopify.formatMoney(cents);
      }
      // Fallback: Format manually with Taka symbol
      const amount = (cents / 100).toFixed(2);
      return '৳ ' + parseFloat(amount).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    };

    // Function to update gallery images based on variant - will be set by gallery logic
    let updateGalleryImage = null;

    // Helper to render specs
    const renderSpecs = (specs, container, sizeVal) => {
      if (!container) return;
      
      if (!specs) {
        container.innerHTML = '<div class="specs-placeholder">choose your size</div>';
        container.classList.remove('has-content');
        return;
      }

      // Check if we have dynamic labels
      const config = window.productSpecConfig;
      const labels = config && config.labels ? config.labels : ['Chest', 'Length', 'Shoulder', 'Sleeve'];

      // Parse specs: if it's a comma string, split it, otherwise assume it matches labels
      let values = [];
      if (typeof specs === 'string') {
          values = specs.split(',').map(s => s.trim());
      } else if (typeof specs === 'object') {
          // Fallback for object format if still used
           values = labels.map(l => specs[l] || 'N/A');
      }

      var html = '<div class="specs-current-size">SIZE ' + sizeVal + ' MEASUREMENTS</div>';
      html += '<div class="specs-grid">';
      
      const unit = window.currentSizeUnit || 'in';

      labels.forEach((label, index) => {
        let val = values[index] || '-';
        if (unit === 'cm' && !isNaN(parseFloat(val))) {
          val = (parseFloat(val) * 2.54).toFixed(1);
        }
        html += '<div class="spec-item">';
        html += '<span class="spec-label">' + label.trim() + '</span>';
        html += '<span class="spec-value">' + val + '</span>';
        html += '</div>';
      });
      
      html += '</div>';
      container.innerHTML = html;
      container.classList.add('has-content');
    };

    const updateVariant = () => {
      const currentSelection = [];
      const inputs = productForm.querySelectorAll('input:checked, select.variant-select');
      
      inputs.forEach(input => {
        const index = input.getAttribute('data-index');
        if (index !== null) {
          currentSelection[parseInt(index)] = input.value;
          
          // Update selected value text label if it exists in the group
          const group = input.closest('.product-variant-group');
          if (group) {
            const label = group.querySelector('.selected-value');
            if (label) label.textContent = input.value;
          }
        }
      });
      
      // Update Size Specs Display based on selection
      const specsDisplay = document.getElementById('SizeSpecsDisplay');
      if (specsDisplay && !specsDisplay.classList.contains('is-hovering')) {
        const selectedSizeInput = productForm.querySelector('.size-radio:checked');
        
        if (selectedSizeInput) {
          const specs = getSpecsForValue(selectedSizeInput.value);
          let label = selectedSizeInput.value.toUpperCase();
          if (label === 'S') label = 'SMALL (S)';
          else if (label === 'M') label = 'MEDIUM (M)';
          else if (label === 'L') label = 'LARGE (L)';
          else if (label === 'XL') label = 'EXTRA LARGE (XL)';
          else if (label === '2XL') label = '2X LARGE (2XL)';
          renderSpecs(specs, specsDisplay, label);
        } else {
          renderSpecs(null, specsDisplay, '');
        }
      }

      const matchedVariant = variants.find(variant => {
        return variant.options.every((opt, i) => opt === currentSelection[i]);
      });

      if (matchedVariant && idInput) {
        idInput.value = matchedVariant.id;
        idInput.disabled = false;
        
        // Update URL with variant
        const url = new URL(window.location);
        url.searchParams.set('variant', matchedVariant.id);
        window.history.replaceState({}, '', url);
        
        // Update Gallery Image when color changes - improved matching
        if (matchedVariant && matchedVariant.featured_image && window.updateGalleryImage) {
          const allSlides = document.querySelectorAll('.product-gallery__slide');
          let foundMatch = false;
          const variantMediaId = matchedVariant.featured_image.id;
          
          // Method 1: Match by media ID (most reliable)
          if (variantMediaId) {
            allSlides.forEach((slide, index) => {
              const slideMediaId = parseInt(slide.dataset.mediaId);
              if (slideMediaId === variantMediaId) {
                window.updateGalleryImage(index);
                foundMatch = true;
              }
            });
          }
          
          // Method 2: Match by variant IDs stored in data-variant-ids
          if (!foundMatch) {
            allSlides.forEach((slide, index) => {
              const variantIds = slide.dataset.variantIds;
              if (variantIds && (variantIds.includes(',' + matchedVariant.id + ',') || variantIds.startsWith(matchedVariant.id + ','))) {
                window.updateGalleryImage(index);
                foundMatch = true;
              }
            });
          }
          
          // Method 3: Match by image URL pattern (extract image ID from URL)
          if (!foundMatch) {
            const variantImageSrc = matchedVariant.featured_image.preview_image?.src || matchedVariant.featured_image.src || '';
            if (variantImageSrc) {
              // Extract image ID from URL (format: /files/123456/image.jpg)
              const variantImageMatch = variantImageSrc.match(/\/files\/(\d+)\//);
              if (variantImageMatch) {
                const variantImageId = variantImageMatch[1];
                allSlides.forEach((slide, index) => {
                  const slideSrc = slide.src || slide.querySelector('img')?.src || '';
                  if (slideSrc.includes('/files/' + variantImageId + '/')) {
                    window.updateGalleryImage(index);
                    foundMatch = true;
                  }
                });
              }
            }
          }
        }
        
        // Calculate sale price for this variant
        const salePriceData = calculateSalePrice(matchedVariant);

        // Update Price
        if (priceDisplay) {
          if (salePriceData.hasSale) {
            priceDisplay.textContent = formatMoney(salePriceData.salePrice);
            priceDisplay.classList.add('product-price--sale');
          } else {
            priceDisplay.textContent = formatMoney(matchedVariant.price);
            priceDisplay.classList.remove('product-price--sale');
          }
        }

        // Update Compare Price
        if (comparePriceDisplay) {
          if (salePriceData.hasSale) {
            comparePriceDisplay.textContent = formatMoney(salePriceData.originalPrice);
            comparePriceDisplay.style.display = '';
          } else {
            comparePriceDisplay.style.display = 'none';
          }
        }

        // Update Discount Badge
        const discountBadge = document.querySelector('.product-price--badge');
        if (discountBadge) {
          if (salePriceData.hasSale && autoDiscountAmount > 0) {
            discountBadge.textContent = 'SAVE ' + formatMoney(autoDiscountAmount);
            discountBadge.style.display = '';
          } else if (salePriceData.hasSale && salePriceData.salePercentage > 0) {
            discountBadge.textContent = '-' + salePriceData.salePercentage + '%';
            discountBadge.style.display = '';
          } else {
            discountBadge.style.display = 'none';
          }
        }

        // Update Low Stock Warning based on selected variant
        if (lowStockWarning) {
          const qty = variantInventory[matchedVariant.id];
          if (qty !== undefined && qty > 0 && qty <= lowStockThreshold) {
            lowStockText.textContent = 'Only ' + qty + ' left in stock!';
            lowStockWarning.style.display = '';
          } else {
            lowStockWarning.style.display = 'none';
          }
        }

        // Update Availability
        const translations = window.productTranslations || {
          addToCart: 'ADD TO CART',
          soldOut: 'SOLD OUT',
          inStock: 'In Stock'
        };
        
        if (matchedVariant.available) {
          if (statusText) statusText.textContent = translations.inStock.toUpperCase();
          if (statusIndicator) {
            statusIndicator.classList.remove('out-of-stock');
            statusIndicator.classList.add('available');
          }
          if (addToCartBtn) {
            addToCartBtn.disabled = false;
            // Only update text to "ADD TO CART" if it's not a WhatsApp button
            if (!addToCartBtn.id || addToCartBtn.id !== 'WhatsAppOrderBtn') {
              addToCartBtn.textContent = translations.addToCart.toUpperCase();
            }
            addToCartBtn.style.display = 'block';
          }
        } else {
          if (statusText) statusText.textContent = translations.soldOut.toUpperCase();
          if (statusIndicator) {
            statusIndicator.classList.remove('available');
            statusIndicator.classList.add('out-of-stock');
          }
          if (addToCartBtn) {
            addToCartBtn.disabled = true;
            addToCartBtn.textContent = translations.soldOut.toUpperCase();
            addToCartBtn.style.display = 'block';
          }
        }
      } else {
        if (idInput) idInput.disabled = true;
        if (addToCartBtn) {
          addToCartBtn.style.display = 'none';
        }
        if (lowStockWarning) lowStockWarning.style.display = 'none';
      }
    };

    productForm.addEventListener('change', updateVariant);
    
    // Aggressive listeners for size radios + Hover Shift Preview
    const getSpecsForValue = (val) => {
      const config = window.productSpecConfig;
      if (!config || !config.data) return null;

      const rawValue = val.trim();
      // Try exact match first
      if (config.data[rawValue]) return config.data[rawValue];
      if (config.data[rawValue.toUpperCase()]) return config.data[rawValue.toUpperCase()];
      if (config.data[rawValue.toLowerCase()]) return config.data[rawValue.toLowerCase()];
      
      // Try alias matching if not found
      // S -> Small, etc. if your keys are full words but values are letters
      for (const key in config.data) {
          if (key.toLowerCase() === rawValue.toLowerCase()) return config.data[key];
      }

      return null;
    };

    const sizeRadios = productForm.querySelectorAll('.size-radio');
    const specsDisplay = document.getElementById('SizeSpecsDisplay');

    sizeRadios.forEach(radio => {
      const parentLabel = radio.closest('.size-slider-item');
      
      radio.addEventListener('click', () => {
        console.log('Size radio clicked:', radio.value);
        setTimeout(updateVariant, 10);
      });

      if (parentLabel && specsDisplay) {
        parentLabel.addEventListener('mouseenter', () => {
          specsDisplay.classList.add('is-hovering');
          const specs = getSpecsForValue(radio.value);
          if (specs) {
            let label = radio.value.toUpperCase();
            if (label === 'S') label = 'SMALL (S)';
            else if (label === 'M') label = 'MEDIUM (M)';
            else if (label === 'L') label = 'LARGE (L)';
            else if (label === 'XL') label = 'EXTRA LARGE (XL)';
            else if (label === '2XL') label = '2X LARGE (2XL)';
            renderSpecs(specs, specsDisplay, label);
          }
        });

        parentLabel.addEventListener('mouseleave', () => {
          specsDisplay.classList.remove('is-hovering');
          // Revert to selected variant
          updateVariant();
        });
      }
    });
    
    // Initial update with small delay to ensure auto-selection is ready
    setTimeout(() => {
      console.log('Initial updateVariant firing...');
      updateVariant();
    }, 200);

    // Watch for dynamic changes to the radio buttons (in case Shopify scripts change them)
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.type === 'attributes' && mutation.attributeName === 'checked') {
          console.log('Radio checked state changed by script');
          updateVariant();
        }
      });
    });

    sizeRadios.forEach(radio => {
      observer.observe(radio, { attributes: true });
    });
    



    // AJAX Add to Cart
    productForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      {%- if product.tags contains 'prepay' -%}
      // Prepay gate: require bKash TrxID before adding to cart
      if (!window.__prepayConfirmed) {
        if (typeof window.openPrepayPopup === 'function') {
          window.openPrepayPopup();
        }
        return;
      }
      // Reset flag after use so next add requires re-confirmation
      window.__prepayConfirmed = false;
      {%- endif -%}
      
      const submitBtn = productForm.querySelector('.add-to-cart-btn');
      if (!submitBtn) return;
      
      const originalText = submitBtn.textContent;
      const translations = window.productTranslations || {
        adding: 'ADDING...',
        added: 'ADDED ✓',
        error: 'ERROR',
        tryAgain: 'TRY AGAIN'
      };
      
      submitBtn.disabled = true;
      submitBtn.textContent = translations.adding;
      submitBtn.classList.add('is-loading');
      
      try {
        const formData = new FormData(productForm);
        
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          body: formData
        });
        
        if (!response.ok) {
          throw new Error(`Add to cart failed: ${response.status}`);
        }
        
        const result = await response.json();
        
        // Check for errors in response
        if (result.errors && result.errors.length > 0) {
          throw new Error(result.errors.join(', '));
        }
        
        submitBtn.textContent = translations.added;
        submitBtn.style.background = '#28a745';
        
        // Auto-apply discount code for specific products
        if (autoDiscountCode) {
          try { await fetch('/discount/' + autoDiscountCode); } catch(e) {}
          // Track code for checkout
          if (!window.__cartDiscountCodes) window.__cartDiscountCodes = [];
          if (window.__cartDiscountCodes.indexOf(autoDiscountCode) === -1) {
            window.__cartDiscountCodes.push(autoDiscountCode);
          }
        }
        
        // Update cart count in header
        try {
          const cartResponse = await fetch('/cart.js');
          if (cartResponse.ok) {
            const cart = await cartResponse.json();
            document.querySelectorAll('[data-cart-count]').forEach(el => {
              el.textContent = cart.item_count || 0;
            });
            
            // Update cart drawer if function exists
            if (typeof window.updateCartDrawer === 'function') {
              window.updateCartDrawer(cart);
            }
          }
        } catch (cartError) {
          console.error('Error updating cart count:', cartError);
        }
        
        // Open cart drawer if function exists
        if (typeof window.openCartDrawer === 'function') {
          window.openCartDrawer();
        }
          
        setTimeout(() => {
          submitBtn.disabled = false;
          submitBtn.textContent = originalText;
          submitBtn.style.background = '';
          submitBtn.classList.remove('is-loading');
        }, 2000);
        
      } catch (error) {
        console.error('Add to cart error:', error);
        submitBtn.textContent = translations.error;
        submitBtn.style.background = '#c33';
        submitBtn.classList.remove('is-loading');
        
        setTimeout(() => {
          submitBtn.disabled = false;
          submitBtn.textContent = translations.tryAgain;
          setTimeout(() => {
            submitBtn.textContent = originalText;
            submitBtn.style.background = '';
          }, 2000);
        }, 1000);
      }
    });
  }

  // Recommendations Logic - Standard Shopify AJAX
  const recommendationsSection = document.querySelector('.product-recommendations');
  if (recommendationsSection) {
    const url = recommendationsSection.dataset.url;
    if (url) {
      fetch(url)
        .then(response => response.text())
        .then(text => {
          const html = new DOMParser().parseFromString(text, 'text/html');
          const grid = html.querySelector('.product-grid');
          const targetGrid = document.getElementById('RecommendationsGrid');
          
          if (grid && targetGrid && grid.innerHTML.trim().length > 0) {
            targetGrid.innerHTML = grid.innerHTML;
            recommendationsSection.style.display = 'block';
          } else {
            recommendationsSection.style.display = 'none';
          }
        })
        .catch(e => {
          console.error('Recommendations failed:', e);
          recommendationsSection.style.display = 'none';
        });
    }
  }
});
</script>

